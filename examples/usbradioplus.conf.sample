; USBRadioPlus audio processing defaults. Installation creates
; /etc/asterisk/usbradioplus.conf when it does not already exist.
;
; Unknown sections, unknown options, invalid
; ranges, and invalid stage orders reject a reload without changing the active
; settings. See usbradioplus.conf(5) for complete rules.

; Flat sections provide shared defaults. A scoped section such as
; [hardware usb] overrides [hardware] for a radio named usb. A radio may also
; select another scoped profile explicitly.

[usb]
; This named section creates RadioPlus/usb and inherits every flat section.
channel_enabled = yes

[asterisk]
; Asterisk receive jitter-buffer controls.
;asterisk_jitter_buffer_enabled = no
;asterisk_jitter_buffer_max_size_ms = 200
;asterisk_jitter_buffer_resync_threshold_ms = 1000
;asterisk_jitter_buffer_implementation = fixed
;asterisk_jitter_buffer_logging_enabled = no
; Force jitter buffering even when Asterisk would not normally use it.
;asterisk_jitter_buffer_force_enabled = no
; Additional target delay used by the adaptive jitter buffer.
;asterisk_jitter_buffer_target_extra_ms = 40
; Delay video to remain synchronized with jitter-buffered audio.
;asterisk_jitter_buffer_video_sync_enabled = no

[hardware]
; CM119 capture and playback levels use dB relative to the normalized mixer
; midpoint. Zero dB is 500 on the 0--999 mixer scale. Values are clamped to
; the hardware range.
;hardware_input_gain_db = 0.0
;hardware_output_a_gain_db = 0.0
;hardware_output_b_gain_db = 0.0
; Route voice, CTCSS, both, auxiliary voice, or nothing to each CM119 playback
; channel.
;hardware_output_a_assignment = voice_ctcss
;hardware_output_b_assignment = off
; Select the COS source.
;hardware_cos_assignment = dsp
; Comma-separated receive and transmit CTCSS frequency lists.
;hardware_rx_ctcss_frequencies = 100.0
;hardware_tx_ctcss_frequencies = 100.0
; De-emphasis and pre-emphasis corner frequency.
;hardware_emphasis_corner_hz = 212.206590789
; Device selection and interface layout.
;hardware_device_identifier = 1-1
;hardware_serial =
;hardware_interface_type = 0
;hardware_eeprom_enabled = yes
; Audio buffering and idle DSP controls.
;hardware_audio_fragment_count = 196
; Device output continues with silence while idle; this bounds its queued audio.
;hardware_audio_queue_size = 20
;hardware_rx_cpu_saver_enabled = no
;hardware_tx_cpu_saver_enabled = no
; Receiver audio and CTCSS indication sources.
;hardware_rx_audio_source = flat
;hardware_rx_ctcss_source = dsp
;hardware_vox_hang_ms = 2000
;hardware_vox_threshold = 0
; DSP COS noise margin while open, not a delay or SINAD setting. The sample-rate
; MICOR-style detector closes strong signals quickly and holds weak or gradually
; fading signals for about 150 ms. Strong means at least 20 dB noise quieting.
;hardware_noise_squelch_hysteresis = 3000
;hardware_noise_filter_type = 0
;hardware_squelch_delay = 0
; Carrier timing, polarity, squelch, and receive CTCSS calibration.
;hardware_rx_on_delay_frames = 0
;hardware_rx_polarity_inverted = no
;hardware_squelch_level = 500
;hardware_rx_ctcss_level = 1.0
;hardware_rx_ctcss_override_enabled = no
;hardware_rx_ctcss_relax = 1
; Transmit CTCSS, signaling polarity, modulation mode, and timing.
;hardware_tx_ctcss_default_hz = 100.0
;hardware_tx_ctcss_level = 200
;hardware_ctcss_turnoff_mode = notone
;hardware_dcs_rx_polarity_inverted = no
;hardware_dcs_tx_polarity_inverted = no
;hardware_lsd_rx_polarity_inverted = no
;hardware_lsd_tx_polarity_inverted = no
; Transmit modulation selection, limiter compatibility, and keying delays.
;hardware_tx_preemphasis_limiter_enabled = yes
;hardware_tx_limiter_only_enabled = no
;hardware_tx_soft_limiter_setpoint = 12000
;hardware_tx_settle_ms = 500
;hardware_tx_rx_blanking_ms = 0
;hardware_tx_off_delay_frames = 0
;hardware_tx_polarity_inverted = no
;hardware_ptt_inverted = no
; Radio identity and signaling metadata.
;hardware_rx_frequency_hz = 0
;hardware_tx_frequency_hz = 0
;hardware_repeater_number = 0
;hardware_area = 0
;hardware_user_key =
; Signaling cadence, voter reporting, and the optional clipping indicator.
;hardware_idle_interval = 0
;hardware_turnoff_count = 0
;hardware_voter_reporting = 0
;hardware_clip_led_gpio = 0
; Configure each available CM119 GPIO as an input or as an output with its
; initial level. Scoped hardware profiles inherit omitted values from this
; flat section; omitted flat values use the module defaults.
;hardware_gpio_1_mode = in
;hardware_gpio_2_mode = in
;hardware_gpio_3_mode = in
;hardware_gpio_4_mode = in
;hardware_gpio_5_mode = in
;hardware_gpio_6_mode = in
;hardware_gpio_7_mode = in
;hardware_gpio_8_mode = in
; Parallel-port device selection. The base address accepts decimal or 0x-prefixed
; notation. Scoped hardware profiles inherit omitted values from this flat
; section; omitted flat values use the module defaults.
;hardware_parallel_port_device = /dev/parport0
;hardware_parallel_port_base_address = 0x378
; Parallel-port outputs may start low or high, or carry PTT.
;hardware_parallel_pin_2_assignment = out0
;hardware_parallel_pin_3_assignment = out0
;hardware_parallel_pin_4_assignment = out0
;hardware_parallel_pin_5_assignment = out0
;hardware_parallel_pin_6_assignment = out0
;hardware_parallel_pin_7_assignment = out0
;hardware_parallel_pin_8_assignment = out0
;hardware_parallel_pin_9_assignment = out0
; Parallel-port inputs may be general-purpose inputs or carry COS or CTCSS.
;hardware_parallel_pin_10_assignment = in
;hardware_parallel_pin_12_assignment = in
;hardware_parallel_pin_13_assignment = in
;hardware_parallel_pin_15_assignment = in

[duplex]
; Radio duplex mode and local 48 kHz repeat route. Scoped duplex profiles
; inherit omitted values from this flat section.
;duplex_radio_mode = 0
;duplex_local_repeat_level = 0
;duplex_local_repeat_mode = hardware

[diagnostics]
; Diagnostic controls. Scoped diagnostics profiles inherit omitted values from
; this flat section.
;diagnostics_trace_type = 0
;diagnostics_trace_level = 0
;diagnostics_fever = 0

[local]
; Enable the local receiver chain. The master switch must also be enabled.
enabled = yes
; Reorder the equalizer and dynamics stages. The equalizer runs immediately
; before the downward expander by default.
stage_order = equalizer,expander,agc,deesser,compressor,limiter
; Three-band tone control.
equalizer_enabled = yes
equalizer_low_gain_db = 2.0
equalizer_low_frequency_hz = 500.0
equalizer_low_slope = 0.7
equalizer_mid_gain_db = -0.5
equalizer_mid_frequency_hz = 1000.0
equalizer_mid_width_octaves = 1.0
equalizer_high_gain_db = -1.0
equalizer_high_frequency_hz = 2000.0
equalizer_high_slope = 0.7
; Split-band sibilance reduction immediately before the compressor by default.
deesser_enabled = no
deesser_frequency_hz = 4000.0
deesser_width_octaves = 1.0
deesser_threshold_dbfs = -18.0
deesser_ratio = 3.0
deesser_max_reduction_db = 4.0
deesser_attack_ms = 2.0
deesser_release_ms = 60.0
; RNNoise runs after de-emphasis, squelch gating, and PL removal, before dynamics.
rnnoise_enabled = no
; Apply a steep receive band-pass immediately after the squelch gate and before
; PL filtering. Cutoffs are the -3 dB crossover frequencies.
receive_bandpass_enabled = yes
receive_bandpass_highpass_hz = 20.0
receive_bandpass_lowpass_hz = 5000.0
; Select one PL-removal filter after the receive band-pass and before RNNoise
; or dynamics: highpass or notch.
; Notch follows and removes the PL tone identified by the decoder.
; Notch and high-pass are mutually exclusive.
ctcss_filter_mode = notch
; -3 dB width of each configured CTCSS notch, 0.2 through 10 Hz. The 5 Hz
; default rejects standard CTCSS encoder error while preserving nearby audio.
ctcss_notch_width_hz = 5.0
; Cutoff for ctcss_filter_mode=highpass, 50 through 500 Hz.
ctcss_highpass_hz = 150.0
; Receive gain immediately after de-emphasis and before fixed filters or
; dynamics, -30 through +30 dB.
input_gain_db = 0.0
; Gain after the chain, -30 through +30 dB.
output_gain_db = 0.0

; Enable automatic gain control.
agc_enabled = yes
; Output target measured as filtered detector-band RMS, not peaks; -40 to -3 dBFS.
agc_target_dbfs = -24.0
; Maximum boost for active weak speech, 0 through 30 dB.
agc_max_gain_db = 6.0
; Maximum attenuation for active loud speech, 0 through 60 dB.
agc_max_attenuation_db = 6.0
; RMS detector averaging time, 10 through 5000 ms; adds no audio buffering.
agc_rms_averaging_ms = 200.0
; Maximum gain increase rate, 0.1 through 100 dB per second.
agc_gain_increase_db_per_second = 2.0
; Maximum gain decrease rate, 0.1 through 100 dB per second.
agc_gain_decrease_db_per_second = 6.0
; Activity opens at this 10 ms detector level, -100 to -3 dBFS, below target.
; Inactivity freezes gain; it does not mute audio or reset gain to unity.
agc_activity_threshold_dbfs = -50.0
; Activity closes below threshold minus this margin, 0 through 12 dB.
agc_activity_hysteresis_db = 3.0
; Require continuous active audio below target minus deadband before raising
; gain, 0 through 10000 ms. Inactivity, reduction or deadband resets the wait.
agc_hold_ms = 500.0
; Hold gain within this distance either side of target, 0 through 6 dB.
agc_deadband_db = 1.0
; Two-pole detector-only high-pass: 0 disables, otherwise 50 through 2000 Hz.
agc_sidechain_highpass_hz = 800.0
; Two-pole detector-only low-pass: 0 disables, otherwise above 0 through
; 3500 Hz; above high-pass when both are enabled. Neither filters program audio.
agc_sidechain_lowpass_hz = 1500.0

; Enable downward expansion to reduce noise between words.
expander_enabled = yes
; Expansion threshold, -100 through -10 dBFS.
expander_threshold_dbfs = -55.0
; Expansion ratio, 1 through 10.
expander_ratio = 1.5
; Maximum expander reduction, 0 through 40 dB.
expander_max_attenuation_db = 9.0
; Expander opening and closing times in milliseconds.
expander_attack_ms = 25.0
expander_release_ms = 750.0
; Expander level-detector bandpass in hertz.
expander_sidechain_highpass_hz = 300.0
expander_sidechain_lowpass_hz = 1500.0

; Enable compression of strong speech.
compressor_enabled = yes
; One full-band compressor (1) or three independent RMS band compressors (3).
; Three bands are below 500 Hz, 500-2000 Hz, and above 2000 Hz by default.
; Only the selected mode's controls are applied; inactive values are retained.
compressor_bands = 3
; Low/mid division, 100-2000 Hz.
compressor_low_crossover_hz = 500.0
; Mid/high division: above low/mid, no more than 5000 Hz, and below half
; the source sample rate (less than 4000 Hz on an 8 kHz link).
compressor_high_crossover_hz = 2000.0
; Low-band compression onset, -60 through 0 dBFS.
compressor_low_threshold_dbfs = -6.0
; Low-band ratio, 1 through 20; module default 2:1.
compressor_low_ratio = 2.5
; Low-band gain after compression, -30 through +30 dB.
compressor_low_makeup_gain_db = 0.0
; Low-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_low_knee_db = 9.0
; Low-band attack, 1-1000 ms; module default 75 ms.
compressor_low_attack_ms = 100.0
; Low-band release, 1-9000 ms; module default 300 ms.
compressor_low_release_ms = 800.0
; Mid-band compression onset, -60 through 0 dBFS.
compressor_mid_threshold_dbfs = -6.0
; Mid-band ratio, 1 through 20; module default 2:1.
compressor_mid_ratio = 2.5
; Mid-band gain after compression, -30 through +30 dB.
compressor_mid_makeup_gain_db = 0.0
; Mid-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_mid_knee_db = 9.0
; Mid-band attack, 1-1000 ms; module default 75 ms.
compressor_mid_attack_ms = 100.0
; Mid-band release, 1-9000 ms; module default 300 ms.
compressor_mid_release_ms = 800.0
; High-band compression onset, -60 through 0 dBFS.
compressor_high_threshold_dbfs = -6.0
; High-band ratio, 1 through 20; module default 2:1.
compressor_high_ratio = 2.5
; High-band gain after compression, -30 through +30 dB.
compressor_high_makeup_gain_db = 0.0
; High-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_high_knee_db = 9.0
; High-band attack, 1-1000 ms; module default 75 ms.
compressor_high_attack_ms = 100.0
; High-band release, 1-9000 ms; module default 300 ms.
compressor_high_release_ms = 800.0
; Three-band detectors measure their own bands without the single-band filters.
; The following unbanded controls apply only with compressor_bands = 1.
; Level above which compression begins, -60 through 0 dBFS.
compressor_threshold_dbfs = -6.0
; Compression ratio, 1 through 20.
compressor_ratio = 2.5
; Gain after compression, -30 through +30 dB.
compressor_makeup_gain_db = 0.0
; Compressor attack and release times in milliseconds.
compressor_attack_ms = 100.0
compressor_release_ms = 800.0
; Compressor level-detector bandpass in hertz.
compressor_sidechain_highpass_hz = 800.0
compressor_sidechain_lowpass_hz = 1500.0

; Enable the shared FFmpeg limiter.
limiter_enabled = yes
; One full-band limiter (1) or three independently limited bands (3).
; The fixed final transmitter limiter is separate and is not changed by this mode.
limiter_bands = 3
; Full-band threshold, -40 through -1 dBFS; active only with limiter_bands = 1.
limiter_threshold_dbfs = -1.5
; Full-band limiting ratio, 1 through 20; default 20:1.
limiter_ratio = 20.0
; Full-band knee, 0 through 18 dB; default 0 is a hard knee.
limiter_knee_db = 0.0
; Full-band attack, 0.1 through 1000 ms; default 1 ms.
limiter_attack_ms = 1.0
; Full-band release, 1 through 9000 ms; default 50 ms.
limiter_release_ms = 50.0
; Band-specific controls and crossovers apply only with limiter_bands = 3.
; Low/mid division, 100-2000 Hz.
limiter_low_crossover_hz = 500.0
; Mid/high division: above low/mid, no more than 5000 Hz, and below half
; the source sample rate (less than 4000 Hz on an 8 kHz link).
limiter_high_crossover_hz = 2000.0
; Low-band threshold, ratio, knee, attack, and release.
limiter_low_threshold_dbfs = -1.0
limiter_low_ratio = 10.0
limiter_low_knee_db = 6.0
limiter_low_attack_ms = 50.0
limiter_low_release_ms = 300.0
; Mid-band threshold, ratio, knee, attack, and release.
limiter_mid_threshold_dbfs = -1.0
limiter_mid_ratio = 10.0
limiter_mid_knee_db = 6.0
limiter_mid_attack_ms = 10.0
limiter_mid_release_ms = 100.0
; High-band threshold, ratio, knee, attack, and release.
limiter_high_threshold_dbfs = -1.0
limiter_high_ratio = 20.0
limiter_high_knee_db = 6.0
limiter_high_attack_ms = 1.0
limiter_high_release_ms = 50.0

[link]
; Enable processing for audio received from connected nodes.
enabled = no
; Link equalization and dynamics can be reordered independently of local receive.
; The equalizer runs immediately before the downward expander by default.
stage_order = equalizer,expander,agc,deesser,compressor,limiter
; Three-band tone control.
equalizer_enabled = yes
equalizer_low_gain_db = 2.0
equalizer_low_frequency_hz = 500.0
equalizer_low_slope = 0.7
equalizer_mid_gain_db = -0.5
equalizer_mid_frequency_hz = 1000.0
equalizer_mid_width_octaves = 1.0
equalizer_high_gain_db = -1.0
equalizer_high_frequency_hz = 2000.0
equalizer_high_slope = 0.7
; Split-band sibilance reduction immediately before the compressor by default.
deesser_enabled = no
deesser_frequency_hz = 4000.0
deesser_width_octaves = 1.0
deesser_threshold_dbfs = -18.0
deesser_ratio = 3.0
deesser_max_reduction_db = 4.0
deesser_attack_ms = 2.0
deesser_release_ms = 60.0
; Gain before and after link dynamics, -30 through +30 dB.
input_gain_db = 0.0
output_gain_db = -6.2
; Enable individual link dynamics stages as required.
expander_enabled = yes
agc_enabled = yes
compressor_enabled = yes
limiter_enabled = yes
; Transparent dynamics settings. RNNoise and CTCSS filtering are not valid.
; Expander threshold and timing.
expander_threshold_dbfs = -55.0
expander_attack_ms = 25.0
expander_release_ms = 750.0
; Output target measured as filtered detector-band RMS, not peaks; -40 to -3 dBFS.
agc_target_dbfs = -24.0
; Maximum boost for active weak speech, 0 through 30 dB.
agc_max_gain_db = 6.0
; Maximum attenuation for active loud speech, 0 through 60 dB.
agc_max_attenuation_db = 6.0
; RMS detector averaging time, 10 through 5000 ms; adds no audio buffering.
agc_rms_averaging_ms = 200.0
; Maximum gain increase rate, 0.1 through 100 dB per second.
agc_gain_increase_db_per_second = 2.0
; Maximum gain decrease rate, 0.1 through 100 dB per second.
agc_gain_decrease_db_per_second = 6.0
; Activity opens at this 10 ms detector level, -100 to -3 dBFS, below target.
; Inactivity freezes gain; it does not mute audio or reset gain to unity.
agc_activity_threshold_dbfs = -50.0
; Activity closes below threshold minus this margin, 0 through 12 dB.
agc_activity_hysteresis_db = 3.0
; Require continuous active audio below target minus deadband before raising
; gain, 0 through 10000 ms. Inactivity, reduction or deadband resets the wait.
agc_hold_ms = 500.0
; Hold gain within this distance either side of target, 0 through 6 dB.
agc_deadband_db = 1.0
; Two-pole detector-only high-pass: 0 disables, otherwise 50 through 2000 Hz.
agc_sidechain_highpass_hz = 800.0
; Two-pole detector-only low-pass: 0 disables, otherwise above 0 through
; 3500 Hz; above high-pass when both are enabled. Neither filters program audio.
agc_sidechain_lowpass_hz = 1500.0
; One full-band compressor (1) or three independent RMS band compressors (3).
; Three bands are below 500 Hz, 500-2000 Hz, and above 2000 Hz by default.
; Only the selected mode's controls are applied; inactive values are retained.
compressor_bands = 3
; Low/mid division, 100-2000 Hz.
compressor_low_crossover_hz = 500.0
; Mid/high division: above low/mid, no more than 5000 Hz, and below half
; the source sample rate (less than 4000 Hz on an 8 kHz link).
compressor_high_crossover_hz = 2000.0
; Low-band compression onset, -60 through 0 dBFS.
compressor_low_threshold_dbfs = -6.0
; Low-band ratio, 1 through 20; module default 2:1.
compressor_low_ratio = 2.0
; Low-band gain after compression, -30 through +30 dB.
compressor_low_makeup_gain_db = 0.0
; Low-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_low_knee_db = 9.0
; Low-band attack, 1-1000 ms; module default 75 ms.
compressor_low_attack_ms = 100.0
; Low-band release, 1-9000 ms; module default 300 ms.
compressor_low_release_ms = 800.0
; Mid-band compression onset, -60 through 0 dBFS.
compressor_mid_threshold_dbfs = -6.0
; Mid-band ratio, 1 through 20; module default 2:1.
compressor_mid_ratio = 2.0
; Mid-band gain after compression, -30 through +30 dB.
compressor_mid_makeup_gain_db = 0.0
; Mid-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_mid_knee_db = 9.0
; Mid-band attack, 1-1000 ms; module default 75 ms.
compressor_mid_attack_ms = 100.0
; Mid-band release, 1-9000 ms; module default 300 ms.
compressor_mid_release_ms = 800.0
; High-band compression onset, -60 through 0 dBFS.
compressor_high_threshold_dbfs = -6.0
; High-band ratio, 1 through 20; module default 2:1.
compressor_high_ratio = 2.0
; High-band gain after compression, -30 through +30 dB.
compressor_high_makeup_gain_db = 0.0
; High-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_high_knee_db = 9.0
; High-band attack, 1-1000 ms; module default 75 ms.
compressor_high_attack_ms = 100.0
; High-band release, 1-9000 ms; module default 300 ms.
compressor_high_release_ms = 800.0
; Three-band detectors measure their own bands without the single-band filters.
; The following unbanded controls apply only with compressor_bands = 1.
compressor_threshold_dbfs = -6.0
compressor_attack_ms = 100.0
compressor_release_ms = 800.0
; One full-band limiter (1) or three independently limited bands (3).
; The fixed final transmitter limiter is separate and is not changed by this mode.
limiter_bands = 3
; Full-band threshold, -40 through -1 dBFS; active only with limiter_bands = 1.
limiter_threshold_dbfs = -1.5
; Full-band limiting ratio, 1 through 20; default 20:1.
limiter_ratio = 20.0
; Full-band knee, 0 through 18 dB; default 0 is a hard knee.
limiter_knee_db = 0.0
; Full-band attack, 0.1 through 1000 ms; default 1 ms.
limiter_attack_ms = 1.0
; Full-band release, 1 through 9000 ms; default 50 ms.
limiter_release_ms = 50.0
; Band-specific controls and crossovers apply only with limiter_bands = 3.
; Low/mid division, 100-2000 Hz.
limiter_low_crossover_hz = 500.0
; Mid/high division: above low/mid, no more than 5000 Hz, and below half
; the source sample rate (less than 4000 Hz on an 8 kHz link).
limiter_high_crossover_hz = 2000.0
; Three-band limiter thresholds and timing.
limiter_low_threshold_dbfs = -1.0
limiter_low_attack_ms = 50.0
limiter_low_release_ms = 300.0
limiter_mid_threshold_dbfs = -1.0
limiter_mid_attack_ms = 10.0
limiter_mid_release_ms = 100.0
limiter_high_threshold_dbfs = -1.0
limiter_high_attack_ms = 1.0
limiter_high_release_ms = 50.0

[voice_telemetry]
; Enable the final transmitter chain for mixed voice and telemetry.
enabled = yes
; Gain ahead of dynamics. The 6 dB default supplies normal composite-path gain.
input_gain_db = 6.0
; Reorder the equalizer and dynamics stages. Fixed transmitter-tail stages are
; not listed here. The de-esser runs immediately before the compressor by default.
stage_order = equalizer,expander,agc,deesser,compressor,limiter
; Three-band voice/telemetry tone control.
equalizer_enabled = yes
equalizer_low_gain_db = 2.0
equalizer_low_frequency_hz = 500.0
equalizer_low_slope = 0.7
equalizer_mid_gain_db = -0.5
equalizer_mid_frequency_hz = 1000.0
equalizer_mid_width_octaves = 1.0
equalizer_high_gain_db = -1.0
equalizer_high_frequency_hz = 2000.0
equalizer_high_slope = 0.7
; Split-band sibilance reduction. Detection and attenuation are confined to a
; bell-shaped band so other voice frequencies do not dip with an S sound.
deesser_enabled = no
deesser_frequency_hz = 4000.0
deesser_width_octaves = 1.0
deesser_threshold_dbfs = -18.0
deesser_ratio = 3.0
deesser_max_reduction_db = 4.0
deesser_attack_ms = 2.0
deesser_release_ms = 60.0
; Enable individual transmitter dynamics stages as required.
expander_enabled = no
agc_enabled = no
compressor_enabled = no
limiter_enabled = no
; Enable the fixed transmit splatter-control filter.
splatter_filter_enabled = yes
; Fixed transmitter bandpass cutoffs, 20..2000 Hz and up to 5000 Hz.
splatter_filter_highpass_hz = 20.0
splatter_filter_lowpass_hz = 5000.0
; Enable or disable the fixed final limiter explicitly.
lookahead_limiter_enabled = no
; Explicit final-limiter ceiling, -30 through -0.1 dBFS.
lookahead_limiter_ceiling_dbfs = -3.0
; Lookahead, attack, and release times in milliseconds.
lookahead_limiter_lookahead_ms = 5.0
lookahead_limiter_attack_ms = 1.0
lookahead_limiter_release_ms = 100.0
; Enable the fixed cleanup low-pass after final limiting.
post_limiter_lowpass_enabled = no
; Cleanup low-pass cutoff, 5000 through 20000 Hz.
post_limiter_lowpass_hz = 5500.0
; Gain at the end of the transmitter chain, -30 through +30 dB.
output_gain_db = 0.0
;
; Numeric dynamics defaults are present even though these stages remain off.
; Expander threshold and timing.
expander_threshold_dbfs = -55.0
expander_attack_ms = 25.0
expander_release_ms = 750.0
; Output target measured as filtered detector-band RMS, not peaks; -40 to -3 dBFS.
agc_target_dbfs = -24.0
; Maximum boost for active weak speech, 0 through 30 dB.
agc_max_gain_db = 6.0
; Maximum attenuation for active loud speech, 0 through 60 dB.
agc_max_attenuation_db = 6.0
; RMS detector averaging time, 10 through 5000 ms; adds no audio buffering.
agc_rms_averaging_ms = 200.0
; Maximum gain increase rate, 0.1 through 100 dB per second.
agc_gain_increase_db_per_second = 2.0
; Maximum gain decrease rate, 0.1 through 100 dB per second.
agc_gain_decrease_db_per_second = 6.0
; Activity opens at this 10 ms detector level, -100 to -3 dBFS, below target.
; Inactivity freezes gain; it does not mute audio or reset gain to unity.
agc_activity_threshold_dbfs = -50.0
; Activity closes below threshold minus this margin, 0 through 12 dB.
agc_activity_hysteresis_db = 3.0
; Require continuous active audio below target minus deadband before raising
; gain, 0 through 10000 ms. Inactivity, reduction or deadband resets the wait.
agc_hold_ms = 500.0
; Hold gain within this distance either side of target, 0 through 6 dB.
agc_deadband_db = 1.0
; Two-pole detector-only high-pass: 0 disables, otherwise 50 through 2000 Hz.
agc_sidechain_highpass_hz = 800.0
; Two-pole detector-only low-pass: 0 disables, otherwise above 0 through
; 3500 Hz; above high-pass when both are enabled. Neither filters program audio.
agc_sidechain_lowpass_hz = 1500.0
; One full-band compressor (1) or three independent RMS band compressors (3).
; Three bands are below 500 Hz, 500-2000 Hz, and above 2000 Hz by default.
; Only the selected mode's controls are applied; inactive values are retained.
compressor_bands = 3
; Low/mid division, 100-2000 Hz.
compressor_low_crossover_hz = 500.0
; Mid/high division: above low/mid, no more than 5000 Hz, and below half
; the source sample rate (less than 4000 Hz on an 8 kHz link).
compressor_high_crossover_hz = 2000.0
; Low-band compression onset, -60 through 0 dBFS.
compressor_low_threshold_dbfs = -6.0
; Low-band ratio, 1 through 20; module default 2:1.
compressor_low_ratio = 2.0
; Low-band gain after compression, -30 through +30 dB.
compressor_low_makeup_gain_db = 0.0
; Low-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_low_knee_db = 9.0
; Low-band attack, 1-1000 ms; module default 75 ms.
compressor_low_attack_ms = 100.0
; Low-band release, 1-9000 ms; module default 300 ms.
compressor_low_release_ms = 800.0
; Mid-band compression onset, -60 through 0 dBFS.
compressor_mid_threshold_dbfs = -6.0
; Mid-band ratio, 1 through 20; module default 2:1.
compressor_mid_ratio = 2.0
; Mid-band gain after compression, -30 through +30 dB.
compressor_mid_makeup_gain_db = 0.0
; Mid-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_mid_knee_db = 9.0
; Mid-band attack, 1-1000 ms; module default 75 ms.
compressor_mid_attack_ms = 100.0
; Mid-band release, 1-9000 ms; module default 300 ms.
compressor_mid_release_ms = 800.0
; High-band compression onset, -60 through 0 dBFS.
compressor_high_threshold_dbfs = -6.0
; High-band ratio, 1 through 20; module default 2:1.
compressor_high_ratio = 2.0
; High-band gain after compression, -30 through +30 dB.
compressor_high_makeup_gain_db = 0.0
; High-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_high_knee_db = 9.0
; High-band attack, 1-1000 ms; module default 75 ms.
compressor_high_attack_ms = 100.0
; High-band release, 1-9000 ms; module default 300 ms.
compressor_high_release_ms = 800.0
; Three-band detectors measure their own bands without the single-band filters.
; The following unbanded controls apply only with compressor_bands = 1.
compressor_threshold_dbfs = -6.0
compressor_attack_ms = 100.0
compressor_release_ms = 800.0
; One full-band limiter (1) or three independently limited bands (3).
; The fixed final transmitter limiter is separate and is not changed by this mode.
limiter_bands = 3
; Full-band threshold, -40 through -1 dBFS; active only with limiter_bands = 1.
limiter_threshold_dbfs = -1.5
; Full-band limiting ratio, 1 through 20; default 20:1.
limiter_ratio = 20.0
; Full-band knee, 0 through 18 dB; default 0 is a hard knee.
limiter_knee_db = 0.0
; Full-band attack, 0.1 through 1000 ms; default 1 ms.
limiter_attack_ms = 1.0
; Full-band release, 1 through 9000 ms; default 50 ms.
limiter_release_ms = 50.0
; Band-specific controls and crossovers apply only with limiter_bands = 3.
; Low/mid division, 100-2000 Hz.
limiter_low_crossover_hz = 500.0
; Mid/high division: above low/mid, no more than 5000 Hz, and below half
; the source sample rate (less than 4000 Hz on an 8 kHz link).
limiter_high_crossover_hz = 2000.0
; Three-band limiter thresholds and timing.
limiter_low_threshold_dbfs = -1.0
limiter_low_attack_ms = 50.0
limiter_low_release_ms = 300.0
limiter_mid_threshold_dbfs = -1.0
limiter_mid_attack_ms = 10.0
limiter_mid_release_ms = 100.0
limiter_high_threshold_dbfs = -1.0
limiter_high_attack_ms = 1.0
limiter_high_release_ms = 50.0
