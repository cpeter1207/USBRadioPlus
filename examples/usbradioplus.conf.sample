[voice_telemetry]
; Enable the final transmitter chain for mixed voice and telemetry.
enabled = yes
; Gain ahead of dynamics. The 6 dB default supplies normal composite-path gain.
input_gain_db = 6.0
; Reorder the equalizer and dynamics stages. The fixed final limiter and
; post-limiter low-pass are not listed here. The de-esser runs immediately before
; the compressor by default.
stage_order = equalizer,expander,agc,deesser,compressor,limiter
; Three-band voice/telemetry tone control.
equalizer_enabled = yes
; Low-shelf boost or cut in dB.
equalizer_low_gain_db = 2.0
; Low-shelf turnover frequency in hertz.
equalizer_low_frequency_hz = 500.0
; Low-shelf transition slope.
equalizer_low_slope = 0.7
; Mid-bell boost or cut in dB.
equalizer_mid_gain_db = -0.5
; Mid-bell center frequency in hertz.
equalizer_mid_frequency_hz = 1000.0
; Mid-bell bandwidth in octaves.
equalizer_mid_width_octaves = 1.0
; High-shelf boost or cut in dB.
equalizer_high_gain_db = -1.0
; High-shelf turnover frequency in hertz.
equalizer_high_frequency_hz = 2000.0
; High-shelf transition slope.
equalizer_high_slope = 0.7
; Split-band sibilance reduction. Detection and attenuation are confined to a
; bell-shaped band so other voice frequencies do not dip with an S sound.
deesser_enabled = no
; Center frequency of the sibilance detector and attenuated band.
deesser_frequency_hz = 4000.0
; Width of the sibilance band in octaves.
deesser_width_octaves = 1.0
; Detector level at which de-essing begins, in dBFS.
deesser_threshold_dbfs = -18.0
; Attenuation ratio above the de-esser threshold.
deesser_ratio = 3.0
; Greatest allowed sibilance-band attenuation in dB.
deesser_max_reduction_db = 4.0
; Time to apply sibilance attenuation in milliseconds.
deesser_attack_ms = 2.0
; Time to restore sibilance-band level in milliseconds.
deesser_release_ms = 60.0
; Enable individual transmitter dynamics stages as required.
expander_enabled = no
; Enable or disable the gated RMS gain rider.
agc_enabled = no
; Enable or disable transmitter compression.
compressor_enabled = no
; Enable or disable transmitter peak limiting.
limiter_enabled = no
; Enable or disable the fixed final limiter explicitly.
lookahead_limiter_enabled = no
; Explicit final-limiter ceiling, -30 through -0.1 dBFS.
lookahead_limiter_ceiling_dbfs = -3.0
; Lookahead, attack, and release times in milliseconds.
lookahead_limiter_lookahead_ms = 5.0
; Final limiter attack time in milliseconds.
lookahead_limiter_attack_ms = 1.0
; Final limiter release time in milliseconds.
lookahead_limiter_release_ms = 100.0
; Enable the fixed cleanup low-pass after final limiting.
post_limiter_lowpass_enabled = no
; Cleanup low-pass cutoff, 5000 through 20000 Hz.
post_limiter_lowpass_hz = 5500.0
; Gain at the end of the transmitter chain, -30 through +30 dB.
output_gain_db = 0.0
;
; Numeric dynamics defaults are present even though these stages remain off.
; Expander threshold and timing.
expander_threshold_dbfs = -55.0
; Expansion ratio, maximum attenuation, and detector-only speech band.
expander_ratio = 1.5
; Maximum downward-expander attenuation in dB.
expander_max_attenuation_db = 9.0
; Expander attack time in milliseconds.
expander_attack_ms = 25.0
; Expander release time in milliseconds.
expander_release_ms = 750.0
; Lower expander detector-band cutoff in hertz.
expander_sidechain_highpass_hz = 800.0
; Upper expander detector-band cutoff in hertz.
expander_sidechain_lowpass_hz = 1500.0
; Output target measured as filtered detector-band RMS, not peaks; -40 to -3 dBFS.
agc_target_dbfs = -24.0
; Maximum boost for active weak speech, 0 through 30 dB.
agc_max_gain_db = 6.0
; Maximum attenuation for active loud speech, 0 through 60 dB.
agc_max_attenuation_db = 6.0
; RMS detector averaging time, 10 through 5000 ms; adds no audio buffering.
agc_rms_averaging_ms = 200.0
; Maximum gain increase rate, 0.1 through 100 dB per second.
agc_gain_increase_db_per_second = 2.0
; Maximum gain decrease rate, 0.1 through 100 dB per second.
agc_gain_decrease_db_per_second = 6.0
; Activity opens at this 10 ms detector level, -100 to -3 dBFS, below target.
; Inactivity freezes gain; it does not mute audio or reset gain to unity.
agc_activity_threshold_dbfs = -50.0
; Activity closes below threshold minus this margin, 0 through 12 dB.
agc_activity_hysteresis_db = 3.0
; Require continuous active audio below target minus deadband before raising
; gain, 0 through 10000 ms. Inactivity, reduction or deadband resets the wait.
agc_hold_ms = 500.0
; Hold gain within this distance either side of target, 0 through 6 dB.
agc_deadband_db = 1.0
; Two-pole detector-only high-pass: 0 disables, otherwise 50 through 2000 Hz.
agc_sidechain_highpass_hz = 800.0
; Two-pole detector-only low-pass: 0 disables, otherwise above 0 through
; 3500 Hz; above high-pass when both are enabled. Neither filters program audio.
agc_sidechain_lowpass_hz = 1500.0
; One full-band compressor (1) or three independent RMS band compressors (3).
; Three bands are below 500 Hz, 500-2000 Hz, and above 2000 Hz by default.
; Only the selected mode's controls are applied; inactive values are retained.
compressor_bands = 3
; Low/mid division, 100-2000 Hz.
compressor_low_crossover_hz = 500.0
; Mid/high division: above low/mid, no more than 5000 Hz, and below half the
; active source sample rate.
compressor_high_crossover_hz = 2000.0
; Low-band compression onset, -60 through 0 dBFS.
compressor_low_threshold_dbfs = -6.0
; Low-band ratio, 1 through 20; module default 2:1.
compressor_low_ratio = 2.0
; Low-band gain after compression, -30 through +30 dB.
compressor_low_makeup_gain_db = 0.0
; Low-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_low_knee_db = 9.0
; Low-band attack, 1-1000 ms; module default 75 ms.
compressor_low_attack_ms = 100.0
; Low-band release, 1-9000 ms; module default 300 ms.
compressor_low_release_ms = 800.0
; Mid-band compression onset, -60 through 0 dBFS.
compressor_mid_threshold_dbfs = -6.0
; Mid-band ratio, 1 through 20; module default 2:1.
compressor_mid_ratio = 2.0
; Mid-band gain after compression, -30 through +30 dB.
compressor_mid_makeup_gain_db = 0.0
; Mid-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_mid_knee_db = 9.0
; Mid-band attack, 1-1000 ms; module default 75 ms.
compressor_mid_attack_ms = 100.0
; Mid-band release, 1-9000 ms; module default 300 ms.
compressor_mid_release_ms = 800.0
; High-band compression onset, -60 through 0 dBFS.
compressor_high_threshold_dbfs = -6.0
; High-band ratio, 1 through 20; module default 2:1.
compressor_high_ratio = 2.0
; High-band gain after compression, -30 through +30 dB.
compressor_high_makeup_gain_db = 0.0
; High-band soft-knee width, 0 through 18 dB; default 9 dB.
compressor_high_knee_db = 9.0
; High-band attack, 1-1000 ms; module default 75 ms.
compressor_high_attack_ms = 100.0
