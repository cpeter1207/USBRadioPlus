; Optional USBRadioPlus audio processing. Copy to
; /etc/asterisk/usbradioplus-processing.conf before editing.
;
; Processing is off in this sample. Unknown sections, unknown options, invalid
; ranges, and invalid stage orders reject a reload without changing the active
; settings. See usbradioplus-processing.conf(5) for complete rules.

[general]
; Master switch for this file. Default is no.
enabled = no
; Asterisk channel prefix to which processing applies.
channel = RadioPlus/
; Enable local receive and incoming-link chains from this section.
;local_enabled = yes
;link_enabled = yes

[local]
; Enable the local receiver chain. The master switch must also be enabled.
enabled = no
; Dynamics order. Use each of expander, agc, compressor, and limiter at most once.
stage_order = expander,agc,compressor,limiter
; RNNoise runs after de-emphasis and squelch gating and before dynamics.
rnnoise_enabled = no
; Local CTCSS removal after dynamics: disabled, notch, comb, or highpass.
ctcss_filter_mode = notch
; Width of each configured CTCSS notch, 0.2 through 10 Hz.
ctcss_notch_width_hz = 2.0
; Cutoff for ctcss_filter_mode=highpass, 50 through 500 Hz.
ctcss_highpass_hz = 300.0
; Gain before the dynamics graph, -30 through +30 dB.
input_gain_db = 0.0
; Gain after the chain, -30 through +30 dB.
output_gain_db = -6.2

; Enable automatic gain control.
agc_enabled = no
; Long-term AGC output target, -40 through -3 dBFS.
target_dbfs = -10.0
; Maximum AGC boost for weak audio, 0 through 30 dB.
max_gain_db = 12.0
; Maximum AGC reduction for strong audio, 0 through 60 dB.
max_attenuation_db = 6.0
; Do not raise signals below this level; it must be below target_dbfs.
agc_floor_dbfs = -60.0
; AGC attack and release times in milliseconds.
attack_ms = 750.0
release_ms = 1500.0
; Reset AGC gain after this much closed-squelch time, 100 through 60000 ms.
reset_after_ms = 3000.0
; AGC level-detector bandpass. Low-pass must be above high-pass.
sidechain_highpass_hz = 800.0
sidechain_lowpass_hz = 1500.0

; Enable downward expansion to reduce noise between words.
expander_enabled = no
; Expansion threshold, -100 through -10 dBFS.
expander_threshold_dbfs = -55.0
; Expansion ratio, 1 through 10.
expander_ratio = 1.5
; Maximum expander reduction, 0 through 40 dB.
expander_max_attenuation_db = 9.0
; Expander opening and closing times in milliseconds.
expander_attack_ms = 10.0
expander_release_ms = 250.0
; Expander level-detector bandpass in hertz.
expander_sidechain_highpass_hz = 800.0
expander_sidechain_lowpass_hz = 1500.0

; Enable compression of strong speech.
compressor_enabled = no
; Level above which compression begins, -60 through 0 dBFS.
compressor_threshold_dbfs = -6.0
; Compression ratio, 1 through 20.
compressor_ratio = 2.0
; Gain after compression, -30 through +30 dB.
compressor_makeup_gain_db = 0.0
; Compressor attack and release times in milliseconds.
compressor_attack_ms = 75.0
compressor_release_ms = 300.0
; Compressor level-detector bandpass in hertz.
compressor_sidechain_highpass_hz = 800.0
compressor_sidechain_lowpass_hz = 1500.0

; Enable the two-band limiter.
limiter_enabled = no
; Frequency dividing the low and high limiter bands, 300 through 2000 Hz.
limiter_crossover_hz = 1000.0
; Low-band threshold, ratio, knee, attack, and release.
low_limiter_threshold_dbfs = -1.5
low_limiter_ratio = 10.0
low_limiter_knee_db = 6.0
low_limiter_attack_ms = 50.0
low_limiter_release_ms = 250.0
; High-band threshold, ratio, knee, attack, and release.
high_clip_dbfs = -1.5
high_limiter_ratio = 20.0
high_limiter_knee_db = 6.0
high_limiter_attack_ms = 0.5
high_limiter_release_ms = 25.0

[link]
; Enable processing for audio received from connected nodes.
enabled = no
; Link dynamics can be reordered independently of local receive.
stage_order = expander,agc,compressor,limiter
; Gain before and after link dynamics, -30 through +30 dB.
input_gain_db = 0.0
output_gain_db = -6.2
; Enable individual link dynamics stages as required.
expander_enabled = no
agc_enabled = no
compressor_enabled = no
limiter_enabled = no
; The numeric controls shown in [local] apply to matching link stages and may
; be repeated here to override them. RNNoise and CTCSS filtering are not valid.

[voice_telemetry]
; Enable the final transmitter chain for mixed voice and telemetry.
enabled = no
; Gain ahead of dynamics. The 6 dB default supplies normal composite-path gain.
input_gain_db = 6.0
; Reorder only dynamics; fixed transmitter stages are not listed here.
stage_order = expander,agc,compressor,limiter
; Enable individual transmitter dynamics stages as required.
expander_enabled = no
agc_enabled = no
compressor_enabled = no
limiter_enabled = no
; Enable the fixed transmit splatter-control filter.
splatter_filter_enabled = yes
; Fixed transmitter bandpass cutoffs, 20..2000 Hz and up to 5000 Hz.
output_highpass_hz = 300.0
output_lowpass_hz = 3000.0
; When omitted, txprelim, txlimonly, and txslimsp in usbradioplus.conf select
; lookahead limiting. Explicit no disables it; yes enables it.
;lookahead_limiter_enabled = no
; Explicit lookahead ceiling, -30 through -0.1 dBFS.
lookahead_limit_dbfs = -3.0
; Lookahead, attack, and release times in milliseconds.
lookahead_ms = 5.0
lookahead_attack_ms = 1.0
lookahead_release_ms = 100.0
; Enable the fixed cleanup low-pass after lookahead limiting.
post_limiter_lowpass_enabled = no
; Cleanup low-pass cutoff, 5000 through 20000 Hz.
post_limiter_lowpass_hz = 8000.0
; Enable a final hard ceiling after the other transmitter stages.
final_clipper_enabled = no
; Final hard ceiling, -30 through -0.5 dBFS.
final_clip_dbfs = -3.0
; Gain at the end of the transmitter chain, -30 through +30 dB.
output_gain_db = 0.0
;
; Expander, AGC, compressor, and limiter numeric controls have the same meanings
; and ranges shown in [local]. Repeat them here to override their values.
