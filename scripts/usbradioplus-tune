def default_value(source, key):
    """Return the shipped value for a source-chain option.

    @param source Processing source name: local, link, or voice_telemetry.
    @param key Configuration option name.
    """
    return SOURCE_DEFAULTS.get(source, {}).get(key, DEFAULTS[key])


def relationship_error(source, key, number, values):
    """Validate coupled filter, threshold, and stage parameters before applying a value.

    @param source Processing source name: local, link, or voice_telemetry.
    @param key Configuration option name.
    @param number Proposed numeric value.
    @param values Current resolved values used for cross-field validation.
    """
    if key == "agc_sidechain_highpass_hz" and 0 < number < 50:
        return "AGC detector high-pass must be 0 (disabled) or 50 through 2000 Hz."
    pairs = {
        "agc_sidechain_lowpass_hz": "agc_sidechain_highpass_hz",
        "expander_sidechain_lowpass_hz": "expander_sidechain_highpass_hz",
        "compressor_sidechain_lowpass_hz": "compressor_sidechain_highpass_hz",
        "compressor_high_crossover_hz": "compressor_low_crossover_hz",
        "limiter_high_crossover_hz": "limiter_low_crossover_hz",
        "receive_bandpass_lowpass_hz": "receive_bandpass_highpass_hz",
        "splatter_filter_lowpass_hz": "splatter_filter_highpass_hz",
    }
    if key in pairs:
        lower_key = pairs[key]
        lower = float(values.get(lower_key, default_value(source, lower_key)))
        if number <= lower and (key != "agc_sidechain_lowpass_hz" or number > 0):
            return f"{SETTINGS[key][0]} must be above {SETTINGS[lower_key][0]} ({lower:g} Hz)."
    reverse = {lower: upper for upper, lower in pairs.items()}
    if key in reverse:
        upper_key = reverse[key]
        upper = float(values.get(upper_key, default_value(source, upper_key)))
        if number >= upper and (key != "agc_sidechain_highpass_hz" or upper > 0):
            return f"{SETTINGS[key][0]} must be below {SETTINGS[upper_key][0]} ({upper:g} Hz)."
    if key == "agc_activity_threshold_dbfs":
        target = float(values.get("agc_target_dbfs", default_value(source, "agc_target_dbfs")))
        if number >= target:
            return f"AGC activity threshold must be below AGC target ({target:g} dBFS)."
    if key == "agc_target_dbfs":
        threshold = float(
            values.get(
                "agc_activity_threshold_dbfs", default_value(source, "agc_activity_threshold_dbfs")
            )
        )
        if number <= threshold:
            return f"AGC target must be above AGC activity threshold ({threshold:g} dBFS)."
    return None


def run(args, check=False):
    """Run a command and capture its text output for the tuning interface.

    @param args Command or dialog argument vector.
    @param check Whether a nonzero child exit status raises an exception.
    """
    return subprocess.run(
        args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=check
    ).stdout


def launch_radio_meter(mode):
    """Launch the live radio-status and audio-meter display.

    @param mode Meter selection; only the combined all display is supported.
    """
    if mode != "all":
        raise ValueError(f"unsupported meter mode: {mode}")
    show_radio_result("COS, CTCSS, PTT, and audio levels", "A")


def complete_configuration():
    """Query the module's complete active processing configuration."""
    radio = run(["asterisk", "-rx", "radioplus tune menu-support 2"])
    processing = run(["asterisk", "-rx", "radioplus processing show"])
    return radio.rstrip() + "\n\n" + processing.rstrip()


def dialog(args):
    """Run the shared accessible dialog widget and return the operator's choice.

    @param args Command or dialog argument vector.
    """
    if "--msgbox" in args and "--ok-button" not in args:
        args = ["--ok-button", "Close"] + args
    # Match asl-menu's `3>&1 1>&2 2>&3`: newt draws the interface on stdout,
    # while the selected tag is returned on stderr.
    result = subprocess.run(
        ["whiptail", "--backtitle", "USBRadioPlus processing"] + args,
        text=True,
        stdout=sys.stderr,
        stderr=subprocess.PIPE,
    )
    return result.returncode, result.stderr.strip()


def read_config():
    """Read the selected unified configuration as UTF-8 text."""
    with open(CONFIG, encoding="utf-8") as stream:
        return stream.read()


def ensure_config():
    """Create a missing configuration from the installed shipped sample."""
    if os.path.exists(CONFIG):
        return
    text, _defaults = shipped_configuration()
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w", encoding="utf-8") as stream:
        stream.write(text)
    set_config_permissions(CONFIG)


def raw_section_values(text, section):
    """Parse explicitly written values from one configuration section.

    @param text Complete configuration text.
    @param section Flat or resolved configuration section name.
    """
    values, active = {}, False
    for line in text.splitlines():
        match = re.match(r"\s*\[([^]]+)\]", line)
        if match:
            active = match.group(1).strip() == section
        elif active:
            match = re.match(r"\s*([A-Za-z0-9_]+)\s*=\s*([^;#]*?)\s*(?:[;#].*)?$", line)
            if match:
                values[match.group(1)] = match.group(2)
    return values


def configured_radios(text):
    """List named radio sections independently of flat defaults and scoped profiles.

    @param text Complete configuration text.
    """
    radios = []
    shared = {"general", "asterisk", "hardware", "duplex", "diagnostics", *SOURCE_KEYS}
    for line in text.splitlines():
        match = re.match(r"\s*\[([^]]+)\]", line)
        if match and " " not in match.group(1).strip() and match.group(1).strip() not in shared:
            radios.append(match.group(1).strip())
    return radios


def resolved_section(text, section):
    """Resolve the selected radio's explicit profile reference or scoped section.

    @param text Complete configuration text.
    @param section Flat or resolved configuration section name.
    """
    if section not in {"general", "asterisk", "hardware", "duplex", "diagnostics", *SOURCE_KEYS}:
        return section
    radios = configured_radios(text)
    node = NODE or (radios[0] if radios else None)
    if not node:
        return section
    if section == "general":
        return node
    reference = raw_section_values(text, node).get(f"{section}_profile", node)
    scoped = f"{section} {reference}"
    section_names = set(re.findall(r"(?m)^\s*\[([^]]+)\]", text))
    return scoped if scoped in section_names else section


def section_values(text, section):
    """Merge shared defaults with the selected radio's resolved section values.

    @param text Complete configuration text.
    @param section Flat or resolved configuration section name.
    """
    resolved = resolved_section(text, section)
    values = raw_section_values(text, section) if resolved != section else {}
    values.update(raw_section_values(text, resolved))
    return values


def active_node():
    """Return the explicitly selected or currently active radio channel."""
    if NODE:
        return NODE
    match = re.search(r"\[([^]]+)\]", run(["asterisk", "-rx", "radioplus active"]))
    return match.group(1) if match else None


def shipped_configuration():
    """Read one complete sample, including Debian-compressed documentation."""
    expected = {key for settings in MODERN_SECTION_SETTINGS.values() for key in settings}
    problems = []
    for candidate in DEFAULT_CONFIG_CANDIDATES:
        # Debian compresses large documentation files; source installs leave them plain.
        for path in (os.fspath(candidate), os.fspath(candidate) + ".gz"):
            if not os.path.isfile(path):
                continue
            reader = gzip.open if path.endswith(".gz") else open
            try:
                with reader(path, "rt", encoding="utf-8") as stream:
                    text = stream.read()
            except (OSError, EOFError, UnicodeError, zlib.error) as error:
                problems.append(f"{path}: {error}")
                continue
            values, section = {}, None
            for line in text.splitlines():
                header = re.match(r"\s*\[([^]]+)\]", line)
                if header:
                    section_name = header.group(1).strip()
                    if section_name in MODERN_SECTION_SETTINGS:
                        section = section_name
                    elif " " in section_name:
                        section = section_name.split(" ", 1)[0]
                    else:
                        section = "general"
                    continue
                if section not in MODERN_SECTION_SETTINGS:
                    continue
                setting = re.match(r"\s*;?\s*([A-Za-z0-9_]+)\s*=\s*(.*?)\s*$", line)
                if setting and setting.group(1) in MODERN_SECTION_SETTINGS[section]:
                    values[setting.group(1)] = setting.group(2)
            missing = expected - values.keys()
            if not missing:
                return text, values
            problems.append(f"{path}: missing " + ", ".join(sorted(missing)))
    details = "\n".join(problems) or "Searched plain and .gz samples in: " + ", ".join(
        os.fspath(path) for path in DEFAULT_CONFIG_CANDIDATES
    )
    raise RuntimeError(
        "The shipped processing defaults are unavailable or incomplete; "
        "reinstall the matching USBRadioPlus package or its configuration sample.\n" + details
    )


def shipped_modern_defaults():
    """Read the installed sample's concrete configuration defaults."""
    return shipped_configuration()[1]


def replace_value(text, section, key, value):
    """Replace one setting while preserving unrelated sections, comments, and assignments.

    @param text Complete configuration text.
    @param section Flat or resolved configuration section name.
    @param key Configuration option name.
    @param value Textual configuration value.
    """
    section = resolved_section(text, section)
    lines, active, found = text.splitlines(keepends=True), False, False
    for index, line in enumerate(lines):
        match = re.match(r"\s*\[([^]]+)\]", line)
        if match:
            active = match.group(1).strip() == section
        elif active and re.match(rf"\s*{re.escape(key)}\s*=", line):
            ending = "\n" if line.endswith("\n") else ""
            lines[index] = f"{key} = {value}{ending}"
            found = True
            break
    if not found:
        for index, line in enumerate(lines):
            match = re.match(r"\s*\[([^]]+)\]", line)
            if match and match.group(1).strip() == section:
                insert_at = index + 1
                while insert_at < len(lines) and not re.match(r"\s*\[", lines[insert_at]):
                    insert_at += 1
                lines.insert(insert_at, f"{key} = {value}\n")
                found = True
                break
    if not found:
        if " " in section or section in MODERN_SECTION_SETTINGS:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            lines.extend([f"\n[{section}]\n", f"{key} = {value}\n"])
        else:
            raise ValueError(f"configuration section [{section}] is missing")
    return "".join(lines)


def atomic_write(text):
    """Atomically replace the selected configuration using a same-directory temporary file.

    @param text Complete configuration text.
    """
    directory = os.path.dirname(CONFIG)
    original = os.stat(CONFIG)
    fd, path = tempfile.mkstemp(prefix=".usbradioplus.", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(path, original.st_mode)
        os.chown(path, original.st_uid, original.st_gid)
        set_config_permissions(path)
        os.replace(path, CONFIG)
    finally:
        if os.path.exists(path):
            os.unlink(path)


def set_config_permissions(path):
    """Set configuration ownership and permissions for Asterisk tuning saves.

    @param path Configuration file whose ownership and permissions are updated.
    """
    try:
        account = pwd.getpwnam("asterisk")
    except KeyError:
        return
    if os.geteuid() == 0:
        os.chown(path, account.pw_uid, account.pw_gid)
    os.chmod(path, 0o640)


def reload_config(old_text):
    """Reload processing settings and restore the prior file if validation fails.

    @param old_text Configuration text before the proposed edit.
    """
    output = run(["asterisk", "-rx", "radioplus processing reload"])
    if "reloaded in place" not in output.lower():
        atomic_write(old_text)
        run(["asterisk", "-rx", "radioplus processing reload"])
        raise RuntimeError("Reload failed; the previous configuration was restored.\n\n" + output)


def restart_required(old_text, updated_text):
    """Detect hardware assignment changes that need an Asterisk restart.

    @param old_text Configuration text before the proposed edit.
    @param updated_text Proposed configuration text.
    """
    old = section_values(old_text, "hardware")
    updated = section_values(updated_text, "hardware")
    return any(old.get(key) != updated.get(key) for key in RESTART_ONLY_HARDWARE_KEYS)


def apply_config(old_text, updated_text):
    """Apply edited configuration with validation, restart handling, and failure restoration.

    @param old_text Configuration text before the proposed edit.
    @param updated_text Proposed configuration text.
    """
    atomic_write(updated_text)
    if not restart_required(old_text, updated_text):
        reload_config(old_text)
        return False
    result = subprocess.run(
        ["systemctl", "restart", "asterisk"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    health = run(["asterisk", "-rx", "module show like chan_usbradioplus"])
    if result.returncode or "chan_usbradioplus.so" not in health or "Running" not in health:
        atomic_write(old_text)
        subprocess.run(["systemctl", "restart", "asterisk"], check=False)
        raise RuntimeError(
            "Asterisk restart failed; the previous configuration was restored.\n\n"
            + result.stdout
            + health
        )
    return True


def prompt_boolean(label, current):
    """Edit an on/off setting with the shared screen-reader-friendly choice widget.

    @param label Operator-facing setting label.
    @param current Current value used to initialize the editor.
    """
    current = "yes" if current.lower() in ("yes", "true", "1", "on") else "no"
    return dialog(
        [
            "--ok-button",
            "Apply",
            "--cancel-button",
            "Cancel",
            "--default-item",
            current,
            "--radiolist",
            f"{label}\nCurrent: {'On' if current == 'yes' else 'Off'}",
            "11",
            "62",
            "2",
            "yes",
            "On",
            "ON" if current == "yes" else "OFF",
            "no",
            "Off",
            "ON" if current == "no" else "OFF",
        ]
    )


def prompt_choice(label, current, choices):
    """Edit an enumeration while preserving focus on the current value.

    @param label Operator-facing setting label.
    @param current Current value used to initialize the editor.
    @param choices Allowed values and their displayed labels.
    """
    height = min(22, max(11, len(choices) + 8))
    args = [
        "--ok-button",
        "Apply",
        "--cancel-button",
        "Cancel",
        "--default-item",
        current,
        "--radiolist",
        f"{label}\nCurrent: {current}",
        str(height),
        "72",
        str(len(choices)),
    ]
    for value, description in choices:
        args += [value, description, "ON" if current == value else "OFF"]
    return dialog(args)


def prompt_number(label, current, number_kind, low=None, high=None, units=""):
    """Edit a bounded numeric value with local range and format validation.

    @param label Operator-facing setting label.
    @param current Current value used to initialize the editor.
    @param number_kind Numeric editor kind: integer, float, or gain.
    @param low Optional inclusive lower bound.
    @param high Optional inclusive upper bound.
    @param units Units displayed beside the value.
    """
    type_name = {"gain": "Gain", "float": "Decimal value", "integer": "Integer"}[number_kind]
    limits = ""
    if low is not None and high is not None:
        limits = f"\nRange: {low:g} to {high:g}{(' ' + units) if units else ''}"
    initial = current or "0"
    # A leading minus is parsed as an option unless the editable value starts
    # with whitespace. Whiptail removes this padding from the returned value.
    if initial.startswith("-"):
        initial = " " + initial
    code, entered = dialog(
        [
            "--ok-button",
            "Apply",
            "--cancel-button",
            "Cancel",
            "--inputbox",
            f"{label}\n{type_name}; current: {current}{limits}",
            "11",
            "70",
            initial,
        ]
    )
    if code:
        return code, entered
    entered = entered.strip()
    try:
        number = int(entered, 0) if number_kind == "integer" else float(entered)
    except ValueError:
        expected = "an integer" if number_kind == "integer" else "a numeric value"
        dialog(["--msgbox", f"Enter {expected}.", "7", "44"])
        return 1, ""
    if number_kind != "integer" and not math.isfinite(number):
        dialog(["--msgbox", "Enter a finite numeric value.", "7", "48"])
        return 1, ""
    if (low is not None and number < low) or (high is not None and number > high):
        dialog(
            [
                "--msgbox",
                f"Value must be between {low:g} and {high:g}{(' ' + units) if units else ''}.",
                "8",
                "58",
            ]
        )
        return 1, ""
    return 0, str(number) if number_kind == "integer" else f"{number:g}"


def prompt_text(label, current, instruction="Enter a value"):
    """Edit a text value using the shared setting-entry widget.

    @param label Operator-facing setting label.
    @param current Current value used to initialize the editor.
    @param instruction Operator-facing entry instructions.
    """
    return dialog(
        [
            "--ok-button",
            "Apply",
            "--cancel-button",
            "Cancel",
            "--inputbox",
            f"{label}\n{instruction}\nCurrent: {current}",
            "11",
            "72",
            current,
        ]
    )


def display_value(kind, value):
    """Format the concrete stored value for its setting type.

    @param kind Value-format or setting kind.
    @param value Textual configuration value.
    """
    if kind == "bool":
        return "On" if value.lower() in ("yes", "true", "1", "on") else "Off"
    if kind == "gain":
        return f"{value} dB"
    return value


def edit_setting(source, key):
    """Validate and apply a numeric or enumerated processing-chain setting.

    @param source Processing source name: local, link, or voice_telemetry.
    @param key Configuration option name.
    """
    text = read_config()
    writable = text
    values = section_values(text, source)
    label, kind, low, high, units, _group = SETTINGS[key]
    current = values.get(key, default_value(source, key))
    if kind == "bool":
        code, new = prompt_boolean(label, current)
    elif kind == "choice":
        choices = "bands" if key.endswith("_bands") else "ctcss_filter"
        code, new = prompt_choice(label, current, CHOICES[choices])
    elif kind == "text":
        return edit_text_setting(source, key)
    else:
        value_type = "gain" if key.endswith("_gain_db") or key == "input_gain_db" else "float"
        code, new = prompt_number(label, current, value_type, low, high, units)
    if code:
        return
    if kind not in {"bool", "choice", "text"}:
        relation = relationship_error(source, key, float(new), values)
        if relation:
            dialog(["--msgbox", relation, "8", "64"])
            return
    updated = replace_value(writable, source, key, new)
    try:
        apply_config(text, updated)
    except RuntimeError as error:
        dialog(["--msgbox", str(error), "12", "70"])


def edit_text_setting(source, key):
    """Validate and apply graph order, frequency-list, or other text settings.

    @param source Processing source name: local, link, or voice_telemetry.
    @param key Configuration option name.
    """
    text = read_config()
    writable = text
    values = section_values(text, source)
    label = SETTINGS[key][0]
    current = values.get(key, default_value(source, key))
    code, entered = prompt_text(
        label,
        current,
        "Enter comma-separated equalizer, expander, agc, deesser, compressor, limiter",
    )
    if code:
        return
    entered = entered.strip().lower()
    if key == "stage_order":
        stages = [item.strip() for item in entered.split(",")]
        allowed = {"equalizer", "expander", "agc", "deesser", "compressor", "limiter"}
        if (
            not stages
            or any(item not in allowed for item in stages)
            or len(stages) != len(set(stages))
        ):
            dialog(
                [
                    "--msgbox",
                    "Stage order contains an unknown, empty, or duplicate stage.",
                    "8",
                    "68",
                ]
            )
            return
        missing = sorted(
            stage
            for stage in allowed - set(stages)
            if values.get(f"{stage}_enabled", default_value(source, f"{stage}_enabled")).lower()
            in ("yes", "true", "1", "on")
        )
        if missing:
            dialog(["--msgbox", "Include every enabled stage: " + ", ".join(missing), "8", "68"])
            return
        entered = ",".join(stages)
    old_text = text
    updated = replace_value(writable, source, key, entered)
    try:
        apply_config(old_text, updated)
    except RuntimeError as error:
        dialog(["--msgbox", str(error), "12", "70"])


def stages_menu(source):
    """Enable, disable, or reorder optional stages for one processing source.

    @param source Processing source name: local, link, or voice_telemetry.
    """
    entries = [
        ("1", "enabled", "Entire chain"),
        ("R", "rnnoise_enabled", "RNNoise"),
        ("Z", "equalizer_enabled", "Three-band equalizer"),
        ("A", "agc_enabled", "AGC"),
        ("E", "expander_enabled", "Downward expander"),
        ("D", "deesser_enabled", "Split-band de-esser"),
        ("C", "compressor_enabled", "Compressor"),
        ("L", "limiter_enabled", "Limiter"),
        ("H", "lookahead_limiter_enabled", "Final limiter"),
    ]
    entries = [
        entry
        for entry in entries
        if not (entry[1] == "rnnoise_enabled" and source != "local")
        and not (entry[1] == "lookahead_limiter_enabled" and source != "voice_telemetry")
    ]
    selected = entries[0][0]
    while True:
        values = section_values(read_config(), source)
        items = []
        for tag, setting, label in entries:
            state = (
                "ON"
                if values.get(setting, default_value(source, setting)).lower()
                in ("yes", "true", "1", "on")
                else "OFF"
            )
            items += [tag, f"{label}: {state}"]
        order = values.get("stage_order", default_value(source, "stage_order"))
        items += ["O", "Processing order: view or change"]
        code, choice = dialog(
            [
                "--ok-button",
                "Select",
                "--cancel-button",
                "Back",
                "--default-item",
                selected,
                "--menu",
                f"{source}: processing stages\nOrder: {order}",
                "22",
                "78",
                "11",
            ]
            + items
        )
        if code:
            return
        selected = choice
        if choice == "O":
            edit_setting(source, "stage_order")
            continue
        target = next(entry for entry in entries if entry[0] == choice)
        edit_setting(source, target[1])


def settings_menu(source, group):
    """Edit one related group of processing parameters.

    @param source Processing source name: local, link, or voice_telemetry.
    @param group Related processing settings to present.
    """
    selected = "1"
    while True:
        values = section_values(read_config(), source)
        keys = [
            key
            for key, data in SETTINGS.items()
            if data[5] == group
            and not (key.startswith("ctcss_") and source != "local")
            and not (key.startswith("receive_bandpass_") and source != "local")
            and not (group == "Final limiter" and source != "voice_telemetry")
            and not (
                key.startswith(("splatter_filter_", "post_limiter_"))
                and source != "voice_telemetry"
            )
        ]
        if group in {"Compressor", "Limiter"}:
            stage = group.lower()
            mode = f"{stage}_bands"
            multiband = values.get(mode, default_value(source, mode)) == "3"
            band_prefixes = tuple(f"{stage}_{band}_" for band in ("low", "mid", "high"))
            # Rebuild after mode changes without discarding the inactive mode's settings.
            keys = [
                key for key in keys if key == mode or key.startswith(band_prefixes) == multiband
            ]
        if not keys:
            print(f"No editable numeric settings are available for {source}: {group}.")
            return
        items = []
        for index, key in enumerate(keys):
            label, _kind, _low, _high, units, _group = SETTINGS[key]
            current = values.get(key, default_value(source, key))
            if SETTINGS[key][1] == "bool":
                current = display_value("bool", current)
            items += [str(index + 1), f"{label}: {current} {units}".rstrip()]
        code, choice = dialog(
            [
                "--ok-button",
                "Select",
                "--cancel-button",
                "Back",
                "--default-item",
                selected,
                "--menu",
                f"{source}: {group} settings",
                "20",
                "78",
                "12",
            ]
            + items
        )
        if code:
            return
        selected = choice
        edit_setting(source, keys[int(choice) - 1])


def source_menu(source):
    """Present filtering, stage, gain, and measurement controls for one source chain.

    @param source Processing source name: local, link, or voice_telemetry.
    """
    groups = [
        "Stages",
        "Filters",
        "Equalizer",
        "AGC",
        "Expander",
        "De-esser",
        "Compressor",
        "Limiter",
        "Final limiter",
        "Input/output",
    ]
    if source == "link":
        groups.remove("Filters")
    if source != "voice_telemetry":
        groups.remove("Final limiter")
    selected = "1"
    while True:
        group_items = sum(
            (
                [str(index), f"{group}: change {group.lower()} settings"]
                for index, group in enumerate(groups, 1)
            ),
            [],
        )
        if source == "local":
            group_items += ["E", "Echo mode: enable or disable"]
        code, choice = dialog(
            [
                "--ok-button",
                "Select",
                "--cancel-button",
                "Back",
                "--default-item",
                selected,
                "--menu",
                f"Tune {source}",
                "21",
                "70",
                "12",
            ]
            + group_items
            + [
                "S",
                "Show processing measurement snapshot",
                "C",
                "Show complete active configuration",
            ]
        )
        if code:
            return
        selected = choice
        if choice.isdigit() and 1 <= int(choice) <= len(groups):
            group = groups[int(choice) - 1]
            if group == "Stages":
                stages_menu(source)
            else:
                settings_menu(source, group)
        elif choice.upper() == "E":
            toggle_echo_mode()
        elif choice.upper() == "S":
            dialog(
                [
                    "--ok-button",
                    "Close",
                    "--title",
                    "USBRadioPlus measurements",
                    "--msgbox",
                    run(["asterisk", "-rx", "radioplus processing stats"]),
                    "27",
                    "100",
                ]
            )
        else:
            dialog(
                [
                    "--ok-button",
                    "Close",
                    "--title",
                    "USBRadioPlus configuration",
                    "--msgbox",
                    complete_configuration(),
                    "27",
                    "100",
                ]
            )


def radio_command(option):
    """Execute a calibration command for the selected radio.

    @param option Module calibration command string.
    """
    return run(["asterisk", "-rx", f"radioplus tune menu-support {option}"]).strip()


def radio_state():
    """Parse complete active radio and calibration settings from the module."""
    output = radio_command("0+9")
    match = re.search(r"(?m)^(\d+(?:,[^,\r\n]+){22})$", output)
    if not match:
        raise RuntimeError("Unable to read the active radio tuning state.\n\n" + output)
    values = match.group(1).split(",")
    return {
        "flat": int(values[0]),
        "tx_has_ctcss": int(values[1]),
        "echo": int(values[2]),
        "carrier": int(values[5]),
        "ctcss": int(values[6]),
        "rx_mixer": int(values[14]),
        "rx_voice": float(values[15]),
        "squelch": int(values[16]),
        "tx_a": int(values[17]),
        "tx_b": int(values[18]),
        "tx_ctcss": int(values[19]),
        "tx_mixa": int(values[12]),
        "tx_mixb": int(values[13]),
    }


def show_radio_result(title, option):
    """Display the result of a live calibration command.

    @param title Operator-facing result title.
    @param option Module calibration command string.
    """
    output = radio_command(option)
    dialog(
        [
            "--ok-button",
            "Close",
            "--title",
            title,
            "--msgbox",
            output or "Operation completed.",
            "18",
            "84",
        ]
    )


def swap_radio_device():
    """Exchange USB assignments between operator-selected radio channels."""
    names = [name.strip() for name in radio_command("3").split(",") if name.strip()]
    if not names:
        dialog(["--msgbox", "No eligible USB radio channels were found.", "8", "58"])
        return
    code, selected = prompt_choice(
        "USB radio channel to swap",
        names[0],
        tuple((name, f"Radio channel {name}") for name in sorted(names)),
    )
    if code:
        return
    output = run(["asterisk", "-rx", f"radioplus tune swap {selected}"]).strip()
    dialog(["--msgbox", output or "USB-device assignments swapped.", "8", "72"])


def select_radio_channel():
    """Choose the configured radio whose settings and calibration are edited."""
    global NODE
    names = configured_radios(read_config())
    if not names:
        dialog(["--msgbox", "No named radio channels are configured.", "8", "58"])
        return
    current = NODE or active_node() or names[0]
    code, selected = prompt_choice(
        "Radio channel",
        current if current in names else names[0],
        tuple((name, f"RadioPlus/{name}") for name in names),
    )
    if code:
        return
    output = run(["asterisk", "-rx", f"radioplus active {selected}"])
    if "set to" not in output.lower():
        dialog(["--msgbox", output.strip() or f"Unable to select {selected}.", "9", "70"])
        return
    NODE = selected


def toggle_echo_mode():
    """Toggle echo using the module's sample-rate-dependent playback path."""
    try:
        enabled = bool(radio_state()["echo"])
    except RuntimeError as error:
        dialog(["--msgbox", str(error), "12", "78"])
        return
    code, value = prompt_boolean("Echo mode", "yes" if enabled else "no")
    if not code:
        show_radio_result("Echo mode", "k1" if value == "yes" else "k0")


def section_options_menu(section, settings, title, actions=()):
    """Edit a non-audio settings section and dispatch its calibration actions.

    @param section Flat or resolved configuration section name.
    @param settings Setting names, labels, and editor kinds.
    @param title Operator-facing result title.
    @param actions Additional live calibration actions for this section.
    """
    keys = list(settings)
    selected = "1"
    while True:
        values = section_values(read_config(), section)
        try:
            defaults = shipped_modern_defaults()
        except RuntimeError as error:
            dialog(["--msgbox", str(error), "12", "78"])
            return
        items = []
        for index, key in enumerate(keys, 1):
            label, kind = settings[key]
            current = values.get(key, defaults[key])
            items += [str(index), f"{label}: {display_value(kind, current)}"]
        for tag, label, _callback in actions:
            items += [tag, label]
        code, choice = dialog(
            [
                "--ok-button",
                "Select",
                "--cancel-button",
                "Back",
                "--default-item",
                selected,
                "--menu",
                title,
                "20",
                "78",
                "12",
            ]
            + items
        )
        if code:
            return
        selected = choice
        action = next((callback for tag, _label, callback in actions if tag == choice), None)
        if action:
            action()
            continue
        key = keys[int(choice) - 1]
        label, kind = settings[key]
        old_text = read_config()
        writable = old_text
        current = values.get(key, defaults[key])
        if kind == "bool":
            code, entered = prompt_boolean(label, current)
        elif kind in CHOICES:
            code, entered = prompt_choice(label, current, CHOICES[kind])
        elif kind == "gain":
            code, entered = prompt_number(label, current, "gain", -30, 30, "dB")
        elif kind == "frequencies":
            code, entered = prompt_text(
                label, current, "Enter positive, comma-separated CTCSS frequencies"
            )
            if code:
                continue
            try:
                frequencies = [float(value.strip()) for value in entered.split(",")]
            except ValueError:
                frequencies = []
            if not frequencies or any(value <= 0 for value in frequencies):
                dialog(["--msgbox", "Enter positive, comma-separated frequencies.", "7", "58"])
                continue
        elif kind in {"integer", "level", "binary", "softlimit", "gpio", "address"}:
            limits = {
                "level": (0, 999),
                "binary": (0, 1),
                "softlimit": (5000, 13000),
                "gpio": (0, 8),
                "address": (0, 0xFFFFFFFF),
            }
            low, high = limits.get(kind, (None, None))
            code, entered = prompt_number(label, current, "integer", low, high)
        elif kind in {"float", "emphasis"}:
            low, high, units = (0.001, 299.999, "Hz") if kind == "emphasis" else (None, None, "")
            code, entered = prompt_number(label, current, "float", low, high, units)
        else:
            code, entered = prompt_text(label, current)
        if code:
            continue
        if not entered.strip():
            dialog(["--msgbox", "The value cannot be empty.", "7", "44"])
            continue
        updated = replace_value(writable, section, key, entered)
        try:
            restarted = apply_config(old_text, updated)
            if restarted:
                dialog(
                    [
                        "--msgbox",
                        "The hardware pin assignment was saved and Asterisk was restarted.",
                        "8",
                        "64",
                    ]
                )
        except RuntimeError as error:
            dialog(["--msgbox", str(error), "12", "70"])


def hardware_menu():
    """Present receive, transmit, USB, GPIO, and parallel-port submenus."""
    groups = (
        ("1", "USB interface", "usb", (("S", "Swap USB-device assignments", swap_radio_device),)),
        (
            "2",
            "Receiver",
            "receive",
            (
                (
                    "N",
                    "Automatically calibrate RX discriminator noise and squelch",
                    lambda: show_radio_result("RX noise calibration", "a"),
                ),
                (
                    "L",
                    "Automatically calibrate RX voice with 1 kHz at 3 kHz deviation",
                    lambda: show_radio_result("RX voice calibration", "i"),
                ),
            ),
        ),
        (
            "3",
            "Transmitter",
            "transmit",
            (
                (
                    "F",
                    "Flash transmitter with three calibration bursts",
                    lambda: show_radio_result("Transmitter calibration bursts", "l"),
                ),
            ),
        ),
        (
            "4",
            "CTCSS and signaling",
            "signaling",
            (
                (
                    "C",
                    "Automatically calibrate RX CTCSS decoder level",
                    lambda: show_radio_result("RX CTCSS calibration", "d"),
                ),
            ),
        ),
        ("5", "CM119 GPIO", "gpio", ()),
        ("6", "Parallel port", "parallel", ()),
    )
    selected = "1"
    while True:
        items = []
        for tag, label, _group, _actions in groups:
            items += [tag, label]
        items += ["M", "Continuous status and RX/TX audio meters"]
        code, choice = dialog(
            [
                "--ok-button",
                "Select",
                "--cancel-button",
                "Back",
                "--default-item",
                selected,
                "--menu",
                "CM119 hardware and radio signaling",
                "18",
                "78",
                "10",
            ]
            + items
        )
        if code:
            return
        selected = choice
        if choice == "M":
            launch_radio_meter("all")
            continue
        _tag, label, group, actions = next(item for item in groups if item[0] == choice)
        settings = {key: HARDWARE_SETTINGS[key] for key in HARDWARE_GROUP_KEYS[group]}
        section_options_menu("hardware", settings, label, actions)


def interactive():
    """Run the tuning session with selection persistence, save, and restoration."""
    if os.geteuid() != 0:
        sys.exit("Run this menu with sudo: sudo usbradioplus-tune")
    if not shutil.which("whiptail"):
        sys.exit("whiptail is required")
    if not sys.stdin.isatty() or not sys.stdout.isatty() or not sys.stderr.isatty():
        sys.exit("usbradioplus-tune requires an interactive terminal.")
    if os.environ.get("TERM", "").lower() in ("", "dumb", "unknown"):
        sys.exit(
            "The terminal type is not usable for a menu (TERM is unset or dumb). "
            "Start it from the same terminal in which asl-menu works."
        )
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "w", encoding="ascii") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit("Another USBRadioPlus processing menu is already running.")
        starting = read_config()
        selected = "1"
        while True:
            code, choice = dialog(
                [
                    "--ok-button",
                    "Select",
                    "--cancel-button",
                    "Exit",
                    "--default-item",
                    selected,
                    "--menu",
                    "Select a configuration section. Audio processing changes apply "
                    "immediately; hardware pin assignments are applied by restarting "
                    "Asterisk.",
                    "18",
                    "72",
                    "10",
                    "1",
                    "Local receiver",
                    "2",
                    "Linked audio",
                    "3",
                    "Voice + telemetry",
                    "4",
                    "Asterisk channel settings",
                    "5",
                    "CM119 hardware",
                    "6",
                    "Duplex operation",
                    "7",
                    "General channel settings",
                    "8",
                    "Diagnostics",
                    "C",
                    "Select active radio channel",
                    "S",
                    "Show complete active configuration",
                    "W",
                    "Save this live processing session",
                    "E",
                    "Write live radio tuning and EEPROM values",
                    "B",
                    "Create a timestamped configuration backup",
                    "R",
                    "Discard live changes since the last save",
                ]
            )
            if code:
                if read_config() == starting:
                    return
                action, selected = dialog(
                    [
                        "--ok-button",
                        "Select",
                        "--cancel-button",
                        "Continue editing",
                        "--menu",
                        "Live processing settings have changed.",
                        "12",
                        "68",
                        "3",
                        "save",
                        "Save changes and exit",
                        "discard",
                        "Discard changes and exit",
                        "continue",
                        "Return to the menu",
                    ]
                )
                if action or selected == "continue":
                    continue
                if selected == "discard":
                    old = read_config()
                    try:
                        apply_config(old, starting)
                    except RuntimeError as error:
                        dialog(["--msgbox", str(error), "12", "70"])
                        continue
                return
            selected = choice
            source_by_tag = {"1": "local", "2": "link", "3": "voice_telemetry"}
            if choice in source_by_tag:
                source_menu(source_by_tag[choice])
            elif choice == "4":
                section_options_menu("asterisk", ASTERISK_SETTINGS, "Asterisk channel settings")
            elif choice == "5":
                hardware_menu()
            elif choice == "6":
                section_options_menu("duplex", DUPLEX_SETTINGS, "Duplex operation")
            elif choice == "7":
                section_options_menu("general", GENERAL_SETTINGS, "General channel settings")
            elif choice == "8":
                section_options_menu("diagnostics", DIAGNOSTICS_SETTINGS, "Diagnostics")
            elif choice.upper() == "C":
                select_radio_channel()
            elif choice.upper() == "S":
                dialog(
                    [
                        "--ok-button",
                        "Close",
                        "--title",
                        "Complete USBRadioPlus configuration",
                        "--msgbox",
                        complete_configuration(),
                        "27",
                        "100",
                    ]
                )
            elif choice.upper() == "W":
                starting = read_config()
                dialog(
                    [
                        "--ok-button",
                        "Close",
                        "--msgbox",
                        "Current processing settings are saved. Use Radio calibration "
                        "and continuous meters to save live radio and EEPROM tuning values.",
                        "9",
                        "72",
                    ]
                )
            elif choice.upper() == "E":
                output = run(["asterisk", "-rx", "radioplus tune menu-support j"])
                dialog(
                    [
                        "--ok-button",
                        "Close",
                        "--title",
                        "Radio tuning save",
                        "--msgbox",
                        output,
                        "9",
                        "70",
                    ]
                )
            elif choice.upper() == "B":
                path = CONFIG + ".bak." + datetime.now().strftime("%Y%m%d-%H%M%S")
                shutil.copy2(CONFIG, path)
                dialog(["--ok-button", "Close", "--msgbox", f"Backup created:\n{path}", "8", "72"])
            elif choice.upper() == "R":
                rc, _ = dialog(
                    [
                        "--yes-button",
                        "Restore",
                        "--no-button",
                        "Cancel",
                        "--yesno",
                        "Restore the configuration from the start of this session?",
                        "8",
                        "64",
                    ]
                )
                if not rc:
                    old = read_config()
                    try:
                        apply_config(old, starting)
                    except RuntimeError as error:
                        dialog(["--msgbox", str(error), "12", "70"])


def main():
    """Parse tuner command-line options and execute validation or interactive tuning."""
    global CONFIG, LOCK, NODE
    parser = argparse.ArgumentParser(description="Interactive USBRadioPlus processing tuner")
    parser.add_argument(
        "--check", action="store_true", help="validate prerequisites and configuration"
    )
    parser.add_argument("--config", default=CONFIG, help="processing configuration path")
    parser.add_argument("--lock", default=LOCK, help="menu lock-file path")
    parser.add_argument(
        "--offline", action="store_true", help="with --check, do not require whiptail or Asterisk"
    )
    parser.add_argument("-n", "--node", help="select the active RadioPlus channel")
    args = parser.parse_args()
    CONFIG, LOCK = args.config, args.lock
    NODE = args.node
    try:
        ensure_config()
        if args.check:
            shipped_modern_defaults()
    except (OSError, RuntimeError, UnicodeError) as error:
        sys.exit(f"usbradioplus-tune: {error}")
    if args.check:
        missing = (
            []
            if args.offline
            else [name for name in ("whiptail", "asterisk") if not shutil.which(name)]
        )
        if missing:
            sys.exit("Missing: " + ", ".join(missing))
        text = read_config()
        section_names = set(re.findall(r"(?m)^\s*\[([^]]+)\]", text))
        absent = [
            section
            for section, _label in SOURCES
            if resolved_section(text, section) not in section_names
        ]
        if absent:
            sys.exit("Missing configuration sections: " + ", ".join(absent))
        print("usbradioplus-tune: configuration and prerequisites are valid")
        return
    if NODE:
        output = run(["asterisk", "-rx", f"radioplus active {NODE}"])
        if "set to" not in output.lower():
            sys.exit(output.strip() or f"Unable to select RadioPlus channel {NODE}")
    interactive()


if __name__ == "__main__":
    main()
