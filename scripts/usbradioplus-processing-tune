    "compressor_release_ms": "300.0", "compressor_sidechain_highpass_hz": "800.0",
    "compressor_sidechain_lowpass_hz": "1500.0", "limiter_crossover_hz": "1000.0",
    "limiter_low_threshold_dbfs": "-1.5", "limiter_low_ratio": "10.0",
    "limiter_low_knee_db": "6.0", "limiter_low_attack_ms": "50.0",
    "limiter_low_release_ms": "250.0", "limiter_high_threshold_dbfs": "-1.5",
    "limiter_high_ratio": "20.0", "limiter_high_knee_db": "6.0",
    "limiter_high_attack_ms": "0.5", "limiter_high_release_ms": "25.0",
    "final_clipper_ceiling_dbfs": "-3.0", "lookahead_limiter_ceiling_dbfs": "-3.0",
    "lookahead_limiter_lookahead_ms": "5.0", "lookahead_limiter_attack_ms": "1.0",
    "lookahead_limiter_release_ms": "100.0", "post_limiter_lowpass_enabled": "no",
    "post_limiter_lowpass_hz": "8000.0", "splatter_filter_highpass_hz": "300.0",
    "splatter_filter_lowpass_hz": "3000.0", "output_gain_db": "0.0",
}

SOURCE_DEFAULTS = {
    # An absent local mode inherits rxhpf; highpass is the effective legacy
    # mode shown by the tuner without silently selecting notch filtering.
    "local": {"ctcss_filter_mode": "highpass", "receive_bandpass_enabled": "yes",
              "output_gain_db": "-6.2"},
    "link": {"output_gain_db": "-6.2"},
    "voice_telemetry": {
        "input_gain_db": "6.0", "output_gain_db": "0.0",
        "stage_order": "equalizer,expander,agc,deesser,compressor,limiter",
        "equalizer_enabled": "yes", "equalizer_low_gain_db": "2.0",
        "equalizer_mid_gain_db": "-0.5", "equalizer_high_gain_db": "-1.0",
        "splatter_filter_enabled": "yes",
    },
}


def default_value(source, key):
    """Return the concrete shipped value for this source and setting."""
    return SOURCE_DEFAULTS.get(source, {}).get(key, DEFAULTS[key])


def relationship_error(source, key, number, values):
    """Validate constraints involving another value before writing the file."""
    pairs = {
        "agc_sidechain_lowpass_hz": "agc_sidechain_highpass_hz",
        "expander_sidechain_lowpass_hz": "expander_sidechain_highpass_hz",
        "compressor_sidechain_lowpass_hz": "compressor_sidechain_highpass_hz",
        "receive_bandpass_lowpass_hz": "receive_bandpass_highpass_hz",
        "splatter_filter_lowpass_hz": "splatter_filter_highpass_hz",
    }
    if key in pairs:
        lower_key = pairs[key]
        lower = float(values.get(lower_key, default_value(source, lower_key)))
        if number <= lower:
            return f"{SETTINGS[key][0]} must be above {SETTINGS[lower_key][0]} ({lower:g} Hz)."
    reverse = {lower: upper for upper, lower in pairs.items()}
    if key in reverse:
        upper_key = reverse[key]
        upper = float(values.get(upper_key, default_value(source, upper_key)))
        if number >= upper:
            return f"{SETTINGS[key][0]} must be below {SETTINGS[upper_key][0]} ({upper:g} Hz)."
    if key == "agc_floor_dbfs":
        target = float(values.get("agc_target_dbfs", default_value(source, "agc_target_dbfs")))
        if number >= target:
            return f"AGC detector floor must be below AGC target ({target:g} dBFS)."
    if key == "agc_target_dbfs":
        floor = float(values.get("agc_floor_dbfs", default_value(source, "agc_floor_dbfs")))
        if number <= floor:
            return f"AGC target must be above AGC detector floor ({floor:g} dBFS)."
    return None


def run(args, check=False):
    return subprocess.run(args, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, check=check).stdout


def launch_radio_tune():
    """Use the canonical radio tuner so calibration behavior stays single-sourced."""
    command = [RADIO_TUNE]
    try:
        result = subprocess.run(command, check=False).returncode
    except OSError as error:
        dialog(["--msgbox", f"Unable to start {RADIO_TUNE}: {error}", "9", "70"])
        return
    if result:
        dialog(["--msgbox", f"Radio tuning menu exited with status {result}.", "8", "58"])


def complete_configuration():
    radio = run(["asterisk", "-rx", "radioplus tune menu-support 2"])
    processing = run(["asterisk", "-rx", "radioplus processing show"])
    return radio.rstrip() + "\n\n" + processing.rstrip()


def dialog(args):
    """Run whiptail, whose numbered/tagged menus match the ASL3 utilities."""
    if "--msgbox" in args and "--ok-button" not in args:
        args = ["--ok-button", "Close"] + args
    # Match asl-menu's `3>&1 1>&2 2>&3`: newt draws the interface on stdout,
    # while the selected tag is returned on stderr.
    result = subprocess.run(["whiptail", "--backtitle", "USBRadioPlus processing"] + args,
                            text=True, stdout=sys.stderr, stderr=subprocess.PIPE)
    return result.returncode, result.stderr.strip()


def read_config():
    with open(CONFIG, encoding="utf-8") as stream:
        return stream.read()


def ensure_config():
    """Install the shipped defaults when no processing file exists."""
    if os.path.exists(CONFIG):
        return
    for candidate in DEFAULT_CONFIG_CANDIDATES:
        if os.path.isfile(candidate):
            os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
            shutil.copyfile(candidate, CONFIG)
            set_config_permissions(CONFIG)
            return
    raise FileNotFoundError(
        f"{CONFIG} is missing and the shipped default configuration was not found")


def section_values(text, section):
    values, active = {}, False
    for line in text.splitlines():
        match = re.match(r"\s*\[([^]]+)\]", line)
        if match:
            active = match.group(1).strip() == section
        elif active:
            match = re.match(r"\s*([A-Za-z0-9_]+)\s*=\s*([^;#]*?)\s*(?:[;#].*)?$", line)
            if match:
                values[match.group(1)] = match.group(2)
    return values


def _asterisk_config_lines(path, visited=None):
    """Expand Asterisk include directives while retaining their file order."""
    visited = set() if visited is None else visited
    path = os.path.abspath(path)
    if path in visited or not os.path.isfile(path):
        return []
    visited.add(path)
    lines = []
    with open(path, encoding="utf-8") as stream:
        for line in stream:
            include = re.match(r'\s*#(?:try)?include\s+["\']?([^"\'\s]+)', line)
            if include:
                pattern = include.group(1)
                if not os.path.isabs(pattern):
                    pattern = os.path.join(os.path.dirname(path), pattern)
                for included in sorted(glob.glob(pattern)):
                    lines.extend(_asterisk_config_lines(included, visited))
            else:
                lines.append(line)
    return lines


def parse_asterisk_channel_config(path, node):
    """Resolve general, template, and channel values like an Asterisk config."""
    sections, parents, current = {}, {}, None
    for line in _asterisk_config_lines(path):
        header = re.match(r"\s*\[([^]]+)\]\s*(?:\(([^)]*)\))?", line)
        if header:
            current = header.group(1).strip()
            sections.setdefault(current, {})
            inherited = [item.strip() for item in (header.group(2) or "").split(",")
                         if item.strip() and item.strip() != "!"]
            if inherited:
                parents[current] = inherited
            continue
        if current:
            setting = re.match(r"\s*([A-Za-z0-9_]+)\s*=\s*([^;#]*?)\s*(?:[;#].*)?$", line)
            if setting:
                sections[current][setting.group(1).lower()] = setting.group(2).strip()

    def resolved(section, stack=()):
        if section in stack:
            raise ValueError("circular Asterisk configuration inheritance")
        values = {}
        for parent in parents.get(section, []):
            values.update(resolved(parent, stack + (section,)))
        values.update(sections.get(section, {}))
        return values

    values = resolved("general")
    values.update(resolved(str(node)))
    return values


def active_node():
    if NODE:
        return NODE
    match = re.search(r"\[([^]]+)\]", run(["asterisk", "-rx", "radioplus active"]))
    return match.group(1) if match else None


def modern_fallback_value(key, value):
    """Translate a configured chan_usbradio spelling and scale to RadioPlus."""
    value = value.strip()
    if key in {"hardware_input_gain_db", "hardware_output_a_gain_db",
               "hardware_output_b_gain_db"}:
        mixer = max(0.0, float(value))
        gain = 20.0 * math.log10(max(0.000001, mixer / 500.0))
        return f"{max(-30.0, min(30.0, gain)):.6g}"
    if key in {"hardware_output_a_assignment", "hardware_output_b_assignment"}:
        return {"no": "off", "tone": "ctcss", "composite": "voice_ctcss"}.get(
            value.lower(), value.lower())
    settings = next((group for group in MODERN_SECTION_SETTINGS.values() if key in group), {})
    kind = settings.get(key, (None, None))[1]
    if kind == "bool":
        if value.lower() in {"yes", "true", "y", "t", "1", "on"}:
            return "yes"
        if value.lower() in {"no", "false", "n", "f", "0", "off"}:
            return "no"
    if kind in {"assignment", "cos", "rx_audio_source", "rx_ctcss_source",
                "ctcss_turnoff", "duplex_mode", "jitter_impl", "gpio_mode",
                "parallel_output", "parallel_input"}:
        lowered = value.lower()
        if kind in {"gpio_mode", "parallel_output"} and lowered == "out":
            return "out0"
        return lowered
    return value


def legacy_fallback_values(path=None, node=None):
    path = MAIN_CONFIG if path is None else path
    node = active_node() if node is None else node
    if not node or not os.path.isfile(path):
        return {}
    legacy = parse_asterisk_channel_config(path, node)
    values = {}
    for modern, old in LEGACY_OPTION_MAP.items():
        if old in legacy:
            try:
                values[modern] = modern_fallback_value(modern, legacy[old])
            except ValueError:
                continue
    return values


def shipped_modern_defaults():
    """Read the documented built-in values shipped with this exact utility."""
    expected = {key for settings in MODERN_SECTION_SETTINGS.values() for key in settings}
    for path in DEFAULT_CONFIG_CANDIDATES:
        if not os.path.isfile(path):
            continue
        values, section = {}, None
        with open(path, encoding="utf-8") as stream:
            for line in stream:
                header = re.match(r"\s*\[([^]]+)\]", line)
                if header:
                    section = header.group(1).strip()
                    continue
                if section not in MODERN_SECTION_SETTINGS:
                    continue
                setting = re.match(r"\s*;?\s*([A-Za-z0-9_]+)\s*=\s*(.*?)\s*$", line)
                if setting and setting.group(1) in MODERN_SECTION_SETTINGS[section]:
                    values[setting.group(1)] = setting.group(2)
        missing = expected - values.keys()
        if not missing:
            return values
    raise RuntimeError(
        "The shipped processing defaults are unavailable or incomplete; reinstall USBRadioPlus.")


def materialize_legacy_fallbacks(text, fallbacks=None):
    """Persist configured legacy values under their modern section names."""
    fallbacks = legacy_fallback_values() if fallbacks is None else fallbacks
    updated = text
    for section, settings in MODERN_SECTION_SETTINGS.items():
        present = section_values(updated, section)
        for key in settings:
            if key not in present and key in fallbacks:
                updated = replace_value(updated, section, key, fallbacks[key])
                present[key] = fallbacks[key]
    return updated


def replace_value(text, section, key, value):
    lines, active, found = text.splitlines(keepends=True), False, False
    for index, line in enumerate(lines):
        match = re.match(r"\s*\[([^]]+)\]", line)
        if match:
            active = match.group(1).strip() == section
        elif active and re.match(rf"\s*{re.escape(key)}\s*=", line):
            ending = "\n" if line.endswith("\n") else ""
            lines[index] = f"{key} = {value}{ending}"
            found = True
            break
    if not found:
        for index, line in enumerate(lines):
            match = re.match(r"\s*\[([^]]+)\]", line)
            if match and match.group(1).strip() == section:
                insert_at = index + 1
                while insert_at < len(lines) and not re.match(r"\s*\[", lines[insert_at]):
                    insert_at += 1
                lines.insert(insert_at, f"{key} = {value}\n")
                found = True
                break
    if not found:
        if section in {"general", "asterisk", "hardware", "duplex", "diagnostics"}:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            lines.extend([f"\n[{section}]\n", f"{key} = {value}\n"])
        else:
            raise ValueError(f"configuration section [{section}] is missing")
    return "".join(lines)


def atomic_write(text):
    directory = os.path.dirname(CONFIG)
    original = os.stat(CONFIG)
    fd, path = tempfile.mkstemp(prefix=".usbradioplus-processing.",
                                dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(path, original.st_mode)
        os.chown(path, original.st_uid, original.st_gid)
        set_config_permissions(path)
        os.replace(path, CONFIG)
    finally:
        if os.path.exists(path):
            os.unlink(path)


def set_config_permissions(path):
    """Let Asterisk persist live tuning while keeping the file non-public."""
    try:
        account = pwd.getpwnam("asterisk")
    except KeyError:
        return
    if os.geteuid() == 0:
        os.chown(path, account.pw_uid, account.pw_gid)
    os.chmod(path, 0o640)


def reload_config(old_text):
    output = run(["asterisk", "-rx", "radioplus processing reload"])
    if "reloaded in place" not in output.lower():
        atomic_write(old_text)
        run(["asterisk", "-rx", "radioplus processing reload"])
        raise RuntimeError("Reload failed; the previous configuration was restored.\n\n" + output)


def restart_required(old_text, updated_text):
    """GPIO direction and parallel-pin routing are initialized at channel start."""
    old = section_values(old_text, "hardware")
    updated = section_values(updated_text, "hardware")
    return any(old.get(key) != updated.get(key) for key in RESTART_ONLY_HARDWARE_KEYS)


def apply_config(old_text, updated_text):
    """Apply a valid edit live, or restart for hardware pin reassignment."""
    atomic_write(updated_text)
    if not restart_required(old_text, updated_text):
        reload_config(old_text)
        return False
    result = subprocess.run(
        ["systemctl", "restart", "asterisk"], text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    health = run(["asterisk", "-rx", "module show like chan_usbradioplus"])
    if result.returncode or "chan_usbradioplus.so" not in health or "Running" not in health:
        atomic_write(old_text)
        subprocess.run(["systemctl", "restart", "asterisk"], check=False)
        raise RuntimeError(
            "Asterisk restart failed; the previous configuration was restored.\n\n"
            + result.stdout + health)
    return True


def edit_setting(source, key):
    text = read_config()
    writable = materialize_legacy_fallbacks(text)
    values = section_values(text, source)
    label, kind, low, high, units, _group = SETTINGS[key]
    current = values.get(key, default_value(source, key))
    if kind == "bool":
        new = "no" if current.lower() in ("yes", "true", "1", "on") else "yes"
    else:
        code, new = dialog(["--ok-button", "Apply", "--cancel-button", "Cancel",
                            "--inputbox", f"{label}\nRange: {low} to {high} {units}",
                            "10", "62", current])
        if code:
            return
        try:
            number = float(new)
        except ValueError:
            dialog(["--msgbox", "Enter a numeric value.", "7", "40"])
            return
        if number < low or number > high:
            dialog(["--msgbox", f"Value must be between {low} and {high} {units}.", "8", "52"])
            return
        relation = relationship_error(source, key, number, values)
        if relation:
            dialog(["--msgbox", relation, "8", "64"])
            return
        new = f"{number:g}"
    updated = replace_value(writable, source, key, new)
    try:
        apply_config(text, updated)
    except RuntimeError as error:
        dialog(["--msgbox", str(error), "12", "70"])


def edit_numeric_setting(source, key):
    """Prompt for and apply a numeric value using ordinary terminal I/O."""
    text = read_config()
    writable = materialize_legacy_fallbacks(text)
    values = section_values(text, source)
    label, _kind, low, high, units, _group = SETTINGS[key]
    current = values.get(key, default_value(source, key))
    try:
        entered = input(f"New {label} ({low} to {high} {units}) [{current}]: ").strip()
    except (EOFError, KeyboardInterrupt):
        print("Change cancelled.")
        return
    if not entered:
        print("No value entered; setting unchanged.")
        return
    try:
        number = float(entered)
    except ValueError:
        print(f"Invalid value {entered!r}; enter a number. Setting unchanged.")
        return
    if number < low or number > high:
        print(f"Value must be between {low} and {high} {units}. Setting unchanged.")
        return
    relation = relationship_error(source, key, number, values)
    if relation:
        print(relation + " Setting unchanged.")
        return
    new = f"{number:g}"
    updated = replace_value(writable, source, key, new)
    try:
        apply_config(text, updated)
    except RuntimeError as error:
        print(str(error))
        return
    print(f"{label} changed from {current} to {new} {units}. Applied successfully.")


def edit_text_setting(source, key):
    """Edit strictly enumerated graph and receive-filter values."""
    text = read_config()
    writable = materialize_legacy_fallbacks(text)
    values = section_values(text, source)
    label = SETTINGS[key][0]
    current = values.get(key, default_value(source, key))
    if key == "stage_order":
        prompt = "Comma-separated equalizer, agc, expander, deesser, compressor, limiter"
    else:
        prompt = "One of: disabled, highpass, notch"
    try:
        entered = input(f"New {label} ({prompt}) [{current}]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print("Change cancelled.")
        return
    if not entered:
        print("No value entered; setting unchanged.")
        return
    if key == "stage_order":
        stages = [item.strip() for item in entered.split(",")]
        allowed = {"equalizer", "expander", "agc", "deesser", "compressor", "limiter"}
        if not stages or any(item not in allowed for item in stages) or len(stages) != len(set(stages)):
            print("Stage order contains an unknown, empty, or duplicate stage; unchanged.")
            return
        entered = ",".join(stages)
    elif entered not in {"disabled", "highpass", "notch"}:
        print("CTCSS filter mode must be disabled, highpass, or notch; unchanged.")
        return
    old_text = text
    updated = replace_value(writable, source, key, entered)
    try:
        apply_config(old_text, updated)
    except RuntimeError as error:
        print(str(error))
        return
    print(f"{label} changed from {current or '(inherited)'} to {entered}. Applied successfully.")


def read_key():
    """Read one key, including terminal arrow-key sequences."""
    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        first = os.read(fd, 1).decode("utf-8", "ignore")
        if first == "\x1b":
            second = os.read(fd, 1).decode("utf-8", "ignore")
            if second == "[":
                third = os.read(fd, 1).decode("utf-8", "ignore")
                if third == "Z":
                    return "SHIFT_TAB"
                return first + second + third
            return first + second
        return first
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, previous)


def read_menu_key(selected, item_count):
    """Read a key while the terminal cursor rests on the selected menu row."""
    rows_up = item_count + 1 - selected
    print(f"\033[s\033[{rows_up}A\r", end="", flush=True)
    keypress = read_key()
    print("\033[u", end="", flush=True)
    return keypress


def stages_menu(source):
    """Screen-reader-friendly, single-key stage toggles."""
    entries = [
        ("1", "enabled", "Entire chain"),
        ("R", "rnnoise_enabled", "RNNoise"),
        ("Z", "equalizer_enabled", "Three-band equalizer"),
        ("A", "agc_enabled", "AGC"),
        ("E", "expander_enabled", "Downward expander"),
        ("D", "deesser_enabled", "Split-band de-esser"),
        ("C", "compressor_enabled", "Compressor"),
        ("L", "limiter_enabled", "Two-band limiter"),
        ("H", "lookahead_limiter_enabled", "Lookahead limiter"),
        ("F", "final_clipper_enabled", "Final clipper"),
    ]
    entries = [entry for entry in entries
               if not (entry[1] == "rnnoise_enabled" and source != "local")
               and not (entry[1] in {"lookahead_limiter_enabled",
                                     "final_clipper_enabled"}
                        and source != "voice_telemetry")]
    selected = 0
    while True:
        values = section_values(read_config(), source)
        print(f"\n{source} stage toggles. Press a listed key to toggle immediately.")
        print("Up and Down arrows move; Enter toggles the current item.")
        print("Tab selects Back; Shift+Tab returns to the list. B, Q, or Escape also go back.")
        for index, (key, setting, label) in enumerate(entries):
            state = "ON" if values.get(setting, default_value(source, setting)).lower() in ("yes", "true", "1", "on") else "OFF"
            marker = ">" if index == selected else " "
            print(f"{marker} {key}. {label}: {state}")
        back_marker = ">" if selected == len(entries) else " "
        print(f"{back_marker} B. Back")
        current_label = "Back button" if selected == len(entries) else entries[selected][2]
        print(f"Current item: {current_label}. Command: ", end="", flush=True)
        keypress = read_menu_key(selected, len(entries))
        print()
        if keypress == "\x1b[A":
            selected = (selected - 1) % (len(entries) + 1)
            label = "Back button" if selected == len(entries) else entries[selected][2]
            print(f"Selected {label}.")
            continue
        if keypress == "\x1b[B":
            selected = (selected + 1) % (len(entries) + 1)
            label = "Back button" if selected == len(entries) else entries[selected][2]
            print(f"Selected {label}.")
            continue
        if keypress == "\t":
            selected = len(entries)
            print("Back button selected. Press Enter to return.")
            continue
        if keypress == "SHIFT_TAB":
            selected = 0
            print(f"Returned to the stage list. Selected {entries[selected][2]}.")
            continue
        if keypress in ("\r", "\n"):
            if selected == len(entries):
                return
            target = entries[selected]
        elif keypress.upper() in ("B", "Q") or keypress == "\x1b":
            return
        elif kind == "address":
            code, entered = dialog(["--ok-button", "Apply", "--cancel-button", "Cancel",
                                    "--inputbox", f"{label}\nDecimal or 0x-prefixed address",
                                    "10", "68", current])
            if code:
                continue
            try:
                number = int(entered, 0)
            except ValueError:
                dialog(["--msgbox", "Enter a decimal or 0x-prefixed address.", "7", "54"])
                continue
            if not 0 <= number <= 0xffffffff:
                dialog(["--msgbox", "Address must fit in 32 bits.", "7", "48"])
                continue
        else:
            matches = [entry for entry in entries if entry[0].upper() == keypress.upper()]
            if not matches:
                print(f"Unrecognized key {keypress!r}.")
                continue
            target = matches[0]
            selected = entries.index(target)
        edit_setting(source, target[1])
        new_values = section_values(read_config(), source)
        state = "ON" if new_values.get(target[1], default_value(source, target[1])).lower() in ("yes", "true", "1", "on") else "OFF"
        print(f"{target[2]} is now {state}.")


def settings_menu(source, group):
    values = section_values(read_config(), source)
    keys = [key for key, data in SETTINGS.items()
            if data[5] == group
            and not (key.startswith("ctcss_") and source != "local")
            and not (key.startswith("receive_bandpass_") and source != "local")
            and not (group == "Lookahead" and source != "voice_telemetry")
            and not (key.startswith(("splatter_filter_", "post_limiter_"))
                     and source != "voice_telemetry")]
    if not keys:
        print(f"No editable numeric settings are available for {source}: {group}.")
        return
    selected = 0
    while True:
        values = section_values(read_config(), source)
        print(f"\n{source}: {group} settings.")
        print("Up and Down arrows move; Enter edits the current setting.")
        print("Tab selects Back; Shift+Tab returns to the list. B, Q, or Escape also go back.")
        for index, key in enumerate(keys):
            label, _kind, _low, _high, units, _group = SETTINGS[key]
            marker = ">" if index == selected else " "
            current = values.get(key, default_value(source, key))
            if SETTINGS[key][1] == "bool":
                current = "ON" if current.lower() in ("yes", "true", "1", "on") else "OFF"
            print(f"{marker} {index + 1}. {label}: {current} {units}".rstrip())
        back_marker = ">" if selected == len(keys) else " "
        print(f"{back_marker} B. Back")
        current_label = "Back button" if selected == len(keys) else SETTINGS[keys[selected]][0]
        print(f"Current item: {current_label}. Command: ", end="", flush=True)
        keypress = read_menu_key(selected, len(keys))
        print()
        if keypress == "\x1b[A":
            selected = (selected - 1) % (len(keys) + 1)
            label = "Back button" if selected == len(keys) else SETTINGS[keys[selected]][0]
            print(f"Selected {label}.")
            continue
        if keypress == "\x1b[B":
            selected = (selected + 1) % (len(keys) + 1)
            label = "Back button" if selected == len(keys) else SETTINGS[keys[selected]][0]
            print(f"Selected {label}.")
            continue
        if keypress == "\t":
            selected = len(keys)
            print("Back button selected. Press Enter to return.")
            continue
        if keypress == "SHIFT_TAB":
            selected = 0
            print(f"Returned to the settings list. Selected {SETTINGS[keys[0]][0]}.")
            continue
        if keypress in ("\r", "\n"):
            if selected == len(keys):
                return
            kind = SETTINGS[keys[selected]][1]
            if kind == "bool":
                edit_setting(source, keys[selected])
            elif kind in ("text", "choice"):
                edit_text_setting(source, keys[selected])
            else:
                edit_numeric_setting(source, keys[selected])
            continue
        if keypress.upper() in ("B", "Q") or keypress == "\x1b":
            return
        if keypress.isdigit() and 1 <= int(keypress) <= len(keys):
            selected = int(keypress) - 1
            print(f"Selected {SETTINGS[keys[selected]][0]}. Press Enter to edit.")
            continue
        print(f"Unrecognized key {keypress!r}.")


def source_menu(source):
    groups = ["Stages", "Filters", "Equalizer", "AGC", "Expander", "De-esser", "Compressor",
              "Two-band limiter", "Lookahead", "Input/output"]
    if source == "link":
        groups.remove("Filters")
    if source != "voice_telemetry":
        groups.remove("Lookahead")
    selected = "1"
    while True:
        group_items = sum(([str(index), f"{group}: change {group.lower()} settings"]
                           for index, group in enumerate(groups, 1)), [])
        code, choice = dialog(["--ok-button", "Select", "--cancel-button", "Back",
                               "--default-item", selected,
                               "--menu", f"Tune {source}",
                               "19", "70", "11"] + group_items +
                              ["S", "Show processing measurement snapshot", "C", "Show complete active configuration"])
        if code:
            return
        selected = choice
        if choice.isdigit() and 1 <= int(choice) <= len(groups):
            group = groups[int(choice) - 1]
            if group == "Stages":
                stages_menu(source)
            else:
                settings_menu(source, group)
        elif choice.upper() == "S":
            dialog(["--ok-button", "Close", "--title", "USBRadioPlus measurements", "--msgbox",
                    run(["asterisk", "-rx", "radioplus processing stats"]), "27", "100"])
        else:
            dialog(["--ok-button", "Close", "--title", "USBRadioPlus configuration", "--msgbox",
                    complete_configuration(), "27", "100"])


def section_options_menu(section, settings, title):
    """Edit non-graph channel settings while preserving main-file fallbacks."""
    keys = list(settings)
    selected = "1"
    while True:
        values = section_values(read_config(), section)
        fallbacks = legacy_fallback_values()
        defaults = shipped_modern_defaults()
        items = []
        for index, key in enumerate(keys, 1):
            label, _kind = settings[key]
            current = values.get(key, fallbacks.get(key, defaults[key]))
            items += [str(index), f"{label}: {current}"]
        code, choice = dialog(["--ok-button", "Select", "--cancel-button", "Back",
                               "--default-item", selected,
                               "--menu", title, "20", "78", "12"] + items)
        if code:
            return
        selected = choice
        key = keys[int(choice) - 1]
        label, kind = settings[key]
        old_text = read_config()
        writable = materialize_legacy_fallbacks(old_text, fallbacks)
        current = values.get(key, fallbacks.get(key, defaults[key]))
        if kind == "gain":
            # A leading minus is parsed as a whiptail option unless the
            # editable initial value begins with whitespace.
            initial = current or "0"
            if initial.startswith("-"):
                initial = " " + initial
            code, entered = dialog(["--ok-button", "Apply", "--cancel-button", "Cancel",
                                    "--inputbox", f"{label}\nRange: -30 to 30 dB; 0 dB is mixer midpoint",
                                    "10", "68", initial])
            if code:
                continue
            try:
                number = float(entered)
            except ValueError:
                dialog(["--msgbox", "Enter a numeric value.", "7", "40"])
                continue
            if number < -30 or number > 30:
                dialog(["--msgbox", "Value must be between -30 and 30 dB.", "8", "52"])
                continue
            entered = f"{number:g}"
        elif kind == "assignment":
            code, entered = dialog(["--ok-button", "Apply", "--cancel-button", "Cancel",
                                    "--radiolist", label, "13", "58", "5",
                                    "off", "No signal", "ON" if current == "off" else "OFF",
                                    "voice", "Voice only", "ON" if current == "voice" else "OFF",
                                    "ctcss", "CTCSS only", "ON" if current == "ctcss" else "OFF",
                                    "voice_ctcss", "Voice and CTCSS", "ON" if current == "voice_ctcss" else "OFF",
                                    "auxvoice", "Auxiliary voice", "ON" if current == "auxvoice" else "OFF"])
            if code:
                continue
        elif kind == "cos":
            choices = (("no", "No COS detection"), ("usb", "USB COS, active high"),
                       ("usbinvert", "USB COS, active low"), ("dsp", "DSP noise squelch"),
                       ("vox", "Voice-operated squelch"), ("pp", "Parallel port, active high"),
                       ("ppinvert", "Parallel port, active low"))
            args = ["--ok-button", "Apply", "--cancel-button", "Cancel",
                    "--radiolist", label, "17", "68", "7"]
            for value, description in choices:
                args += [value, description, "ON" if current == value else "OFF"]
            code, entered = dialog(args)
            if code:
                continue
        elif kind in CHOICES:
            choices = CHOICES[kind]
            args = ["--ok-button", "Apply", "--cancel-button", "Cancel",
                    "--radiolist", label, "16", "70", str(len(choices))]
            for value, description in choices:
                args += [value, description, "ON" if current == value else "OFF"]
            code, entered = dialog(args)
            if code:
                continue
        elif kind == "bool":
            code, entered = dialog(["--ok-button", "Apply", "--cancel-button", "Cancel",
                                    "--radiolist", label, "10", "52", "2",
                                    "yes", "Enabled", "ON" if current == "yes" else "OFF",
                                    "no", "Disabled", "ON" if current == "no" else "OFF"])
            if code:
                continue
        elif kind == "frequencies":
            code, entered = dialog(["--ok-button", "Apply", "--cancel-button", "Cancel",
                                    "--inputbox", f"{label}\nComma-separated CTCSS frequencies",
                                    "10", "68", current])
            if code:
                continue
            if not entered.strip():
                dialog(["--msgbox", "Enter at least one CTCSS frequency.", "7", "52"])
                continue
            try:
                frequencies = [float(value.strip()) for value in entered.split(",")]
            except ValueError:
                frequencies = []
            if not frequencies or any(value <= 0 for value in frequencies):
                dialog(["--msgbox", "Enter positive, comma-separated frequencies.", "7", "58"])
                continue
        else:
            ranges = {"emphasis": (0.001, 299.999, "Hz")}
            hint = "Enter a number" if kind in {"integer", "float", "level", "binary", "softlimit", "gpio", "emphasis"} else "Enter a value"
            if kind in ranges:
                low, high, units = ranges[kind]
                hint = f"Range: {low:g} to {high:g} {units}"
            code, entered = dialog(["--ok-button", "Apply", "--cancel-button", "Cancel",
                                    "--inputbox", f"{label}\n{hint}", "10", "68", current])
            if code:
                continue
            if kind in {"integer", "level", "binary", "softlimit", "gpio"}:
                try:
                    number = int(entered, 0)
                except ValueError:
                    dialog(["--msgbox", "Enter an integer value.", "7", "44"])
                    continue
                if kind == "level" and not 0 <= number <= 999:
                    dialog(["--msgbox", "Value must be from 0 through 999.", "7", "48"])
                    continue
                limits = {"binary": (0, 1), "softlimit": (5000, 13000), "gpio": (0, 8)}
                if kind in limits and not limits[kind][0] <= number <= limits[kind][1]:
                    dialog(["--msgbox", f"Value must be from {limits[kind][0]} through {limits[kind][1]}.", "7", "52"])
                    continue
            elif kind in {"float", "emphasis"}:
                try:
                    number = float(entered)
                except ValueError:
                    dialog(["--msgbox", "Enter a numeric value.", "7", "44"])
                    continue
                if kind == "emphasis" and not 0.0 < number < 300.0:
                    dialog(["--msgbox", "Value must be greater than 0 and less than 300 Hz.", "7", "58"])
                    continue
            elif not entered.strip():
                dialog(["--msgbox", "The value cannot be empty.", "7", "44"])
                continue
        updated = replace_value(writable, section, key, entered)
        try:
            restarted = apply_config(old_text, updated)
            if restarted:
                dialog(["--msgbox",
                        "The hardware pin assignment was saved and Asterisk was restarted.",
                        "8", "64"])
        except RuntimeError as error:
            dialog(["--msgbox", str(error), "12", "70"])


def interactive():
    if os.geteuid() != 0:
        sys.exit("Run this menu with sudo: sudo usbradioplus-processing-tune")
    if not shutil.which("whiptail"):
        sys.exit("whiptail is required")
    if not sys.stdin.isatty() or not sys.stdout.isatty() or not sys.stderr.isatty():
        sys.exit("usbradioplus-processing-tune requires an interactive terminal.")
    if os.environ.get("TERM", "").lower() in ("", "dumb", "unknown"):
        sys.exit("The terminal type is not usable for a menu (TERM is unset or dumb). "
                 "Start it from the same terminal in which asl-menu works.")
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "w", encoding="ascii") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit("Another USBRadioPlus processing menu is already running.")
        starting = read_config()
        selected = "1"
        while True:
            code, choice = dialog(["--ok-button", "Select", "--cancel-button", "Exit",
                                   "--default-item", selected,
                                   "--menu",
                                   "Select a configuration section. Audio processing changes apply immediately; hardware pin assignments are applied by restarting Asterisk.",
                                   "18", "72", "10",
                                   "1", "Local receiver",
                                   "2", "Linked audio",
                                   "3", "Voice + telemetry",
                                   "4", "Asterisk channel settings",
                                   "5", "CM119 hardware",
                                   "6", "Duplex operation",
                                   "7", "General channel settings",
                                   "8", "Diagnostics",
                                   "T", "Radio calibration and continuous meters",
                                   "S", "Show complete active configuration",
                                   "W", "Save this live processing session",
                                   "E", "Write live radio tuning and EEPROM values",
                                   "B", "Create a timestamped configuration backup",
                                   "R", "Discard live changes since the last save"])
            if code:
                if read_config() == starting:
                    return
                action, selected = dialog(["--ok-button", "Select", "--cancel-button", "Continue editing",
                                           "--menu", "Live processing settings have changed.", "12", "68", "3",
                                           "save", "Save changes and exit",
                                           "discard", "Discard changes and exit",
                                           "continue", "Return to the menu"])
                if action or selected == "continue":
                    continue
                if selected == "discard":
                    old = read_config()
                    try:
                        apply_config(old, starting)
                    except RuntimeError as error:
                        dialog(["--msgbox", str(error), "12", "70"])
                        continue
                return
            selected = choice
            source_by_tag = {"1": "local", "2": "link", "3": "voice_telemetry"}
            if choice in source_by_tag:
                source_menu(source_by_tag[choice])
            elif choice == "4":
                section_options_menu("asterisk", ASTERISK_SETTINGS, "Asterisk channel settings")
            elif choice == "5":
                section_options_menu("hardware", HARDWARE_SETTINGS, "CM119 hardware and radio signaling")
            elif choice == "6":
                section_options_menu("duplex", DUPLEX_SETTINGS, "Duplex operation")
            elif choice == "7":
                section_options_menu("general", GENERAL_SETTINGS, "General channel settings")
            elif choice == "8":
                section_options_menu("diagnostics", DIAGNOSTICS_SETTINGS, "Diagnostics")
            elif choice.upper() == "T":
                launch_radio_tune()
            elif choice.upper() == "S":
                dialog(["--ok-button", "Close", "--title", "Complete USBRadioPlus configuration", "--msgbox",
                        complete_configuration(), "27", "100"])
            elif choice.upper() == "W":
                starting = read_config()
                dialog(["--ok-button", "Close", "--msgbox",
                        "Current processing settings are saved. Use Radio calibration and continuous meters to save live radio and EEPROM tuning values.",
                        "9", "72"])
            elif choice.upper() == "E":
                output = run(["asterisk", "-rx", "radioplus tune menu-support j"])
                dialog(["--ok-button", "Close", "--title", "Radio tuning save", "--msgbox",
                        output, "9", "70"])
            elif choice.upper() == "B":
                path = CONFIG + ".bak." + datetime.now().strftime("%Y%m%d-%H%M%S")
                shutil.copy2(CONFIG, path)
                dialog(["--ok-button", "Close", "--msgbox", f"Backup created:\n{path}", "8", "72"])
            elif choice.upper() == "R":
                rc, _ = dialog(["--yes-button", "Restore", "--no-button", "Cancel",
                                "--yesno", "Restore the configuration from the start of this session?", "8", "64"])
                if not rc:
                    old = read_config()
                    try:
                        apply_config(old, starting)
                    except RuntimeError as error:
                        dialog(["--msgbox", str(error), "12", "70"])


def main():
    global CONFIG, LOCK, NODE
    parser = argparse.ArgumentParser(description="Interactive USBRadioPlus processing tuner")
    parser.add_argument("--check", action="store_true", help="validate prerequisites and configuration")
    parser.add_argument("--config", default=CONFIG, help="processing configuration path")
    parser.add_argument("--lock", default=LOCK, help="menu lock-file path")
    parser.add_argument("--offline", action="store_true",
                        help="with --check, do not require whiptail or Asterisk")
    parser.add_argument("-n", "--node", help="select the active RadioPlus channel")
    args = parser.parse_args()
    CONFIG, LOCK = args.config, args.lock
    NODE = args.node
    ensure_config()
    if args.check:
        missing = [] if args.offline else [name for name in ("whiptail", "asterisk", RADIO_TUNE)
                                           if not shutil.which(name)]
        if missing:
            sys.exit("Missing: " + ", ".join(missing))
        text = read_config()
        section_names = set(re.findall(r"(?m)^\s*\[([^]]+)\]", text))
        absent = [section for section, _label in SOURCES if section not in section_names]
        if absent:
            sys.exit("Missing configuration sections: " + ", ".join(absent))
        print("usbradioplus-processing-tune: configuration and prerequisites are valid")
        return
    if NODE:
        output = run(["asterisk", "-rx", f"radioplus active {NODE}"])
        if "set to" not in output.lower():
            sys.exit(output.strip() or f"Unable to select RadioPlus channel {NODE}")
    interactive()


if __name__ == "__main__":
    main()
