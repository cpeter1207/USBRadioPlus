PROJECT_NAME           = USBRadioPlus
DOT_GRAPH_MAX_NODES    = 128
PROJECT_NUMBER         =
PROJECT_BRIEF          = "Enhanced AllStarLink USB radio channel driver"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = src doc/developer.dox doc/rpt-advanced-interface.md
FILE_PATTERNS           = *.c *.h *.dox
# Upstream reference fixtures are test data, not maintained implementation.
EXCLUDE                = tests/fixtures
EXTENSION_MAPPING      = sh=Python no_extension=Python
FILTER_PATTERNS        = "*.sh=python3 tools/doxygen_shell_filter.py"
PYTHON_DOCSTRING       = NO
RECURSIVE               = YES
MACRO_EXPANSION         = YES
EXPAND_ONLY_PREDEF      = YES
PREDEFINED             = "__attribute__(x)=" "_Alignas(x)=" \
			 "_Atomic(x)=x" \
			 "_Static_assert(...)= " \
			 "AST_MUTEX_DEFINE_STATIC(name)=static ast_mutex_t name" \
                         "AST_MODULE_INFO(...)= "
EXTRACT_ALL             = NO
EXTRACT_STATIC          = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_IF_INCOMPLETE_DOC  = YES
WARN_NO_PARAMDOC        = YES
GENERATE_XML           = YES
WARN_AS_ERROR           = FAIL_ON_WARNINGS
WARN_LOGFILE            = build/doxygen-warnings.log
GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
FULL_SIDEBAR            = YES
GENERATE_LATEX          = NO
HAVE_DOT                = YES
CALL_GRAPH              = YES
CALLER_GRAPH            = YES
SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
QUIET                   = YES
